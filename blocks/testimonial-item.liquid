{{ 'component-testimonial-item.css' | asset_url | stylesheet_tag }}
{% capture content %}{% content_for 'blocks' %}{% endcapture %}
{% render 'testimonial-item', block: block, content: content %}

{% schema %}
{
  "name": "Testimonial item",
  "tag": null,
  "blocks": [
    { "type": "image" },
    { "type": "group" }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "Vertical on mobile",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Mobile alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.direction == 'vertical' or block.settings.vertical_on_mobile }}"
    },
    { "type": "header", "content": "Gap" },
    { "type": "range", "id": "gap_desktop", "label": "Desktop gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 80 },
    { "type": "range", "id": "gap_mobile", "label": "Mobile gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 36 },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "border_thickness", "label": "Border thickness", "min": 0, "max": 8, "step": 1, "unit": "px", "default": 0 },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corner radius",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "slightly_rounded", "label": "Slightly rounded" },
        { "value": "rounded", "label": "Rounded" },
        { "value": "pill", "label": "Pill" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "square"
    },
    { "type": "range", "id": "custom_corner_radius", "label": "t:labels.custom_corner_radius", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24, "visible_if": "{{ block.settings.corner_radius == 'custom' }}" },
    {
      "type": "select",
      "id": "shadow",
      "label": "Shadow",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "none"
    },
    { "type": "header", "content": "Background" },
    { "type": "color", "alpha": true, "id": "background_color", "label": "Background color" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "header", "content": "Overlay" },
    {
      "type": "color",
      "alpha": true,
      "id": "overlay_color",
      "label": "Overlay color"
    }
  ],
  "presets": [
    {
      "name": "Testimonial item",
      "category": "Trust & social proof",
      "settings": {
        "direction": "horizontal",
        "position": "center",
        "alignment": "center",
        "vertical_on_mobile": true,
        "alignment_mobile": "center",
        "gap_desktop": 80,
        "gap_mobile": 36,
        "border_thickness": 0,
        "corner_radius": "square",
        "shadow": "none"
},
      "blocks": [
        {
          "type": "image",
          "settings": {
            "image_ratio_desktop": "square",
            "image_ratio_mobile": "square",
            "width_desktop": "fill",
            "width_mobile": "fill"
          }
        },
        {
          "type": "group",
          "settings": {
            "direction": "vertical",
            "alignment": "left",
            "width": "fill",
            "height": "fill",
            "gap_desktop": 16,
            "gap_mobile": 12,
            "appearance_type": "inherit",
            "border_type": "none",
            "corner_radius": "square",
            "shadow": "none"
          },
          "blocks": [
            { "type": "eyebrow", "settings": { "text": "<p>FROM THE PEOPLE</p>" } },
            { "type": "icon", "settings": { "source": "library", "icon": "five-stars", "icon_width": 74, "custom_mobile": false } },
            { "type": "text", "settings": { "text": "<p>Share a customer testimonial that builds trust in your products and brand.</p>", "text_size": "md" } },
            { "type": "heading", "settings": { "text": "<p>— Customer name</p>", "heading_size": "xs", "html_tag": "h5", "width": "fit", "customize_mobile_size": false, "width_mobile": "fit" } }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
