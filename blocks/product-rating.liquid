{% doc %}
  Renders standard Shopify review metafields or a supplied review app.
  Products without reviews show five gray stars and a zero review count.
{% enddoc %}
{% liquid
  assign rating_product = closest.product | default: product
  assign product_rating = rating_product.metafields.reviews.rating.value
  assign rating_count = rating_product.metafields.reviews.rating_count.value | default: 0 | plus: 0 | at_least: 0
  assign rating_max = product_rating.scale_max | default: 5 | at_least: 1
  assign rating_value = product_rating.rating | default: 0 | times: 5.0 | divided_by: rating_max | at_least: 0 | at_most: 5
  if rating_count == 0 or product_rating == blank
    assign rating_value = 0
  endif
  assign rating_percentage = rating_value | times: 20
%}
{% capture review_app_content %}{% content_for 'blocks' %}{% endcapture %}
{% assign review_app_content = review_app_content | strip %}
{% if review_app_content != blank %}
  <div class="product-review-app" {{ block.shopify_attributes }}>{{ review_app_content }}</div>
{% else %}
  <div class="product-rating" {{ block.shopify_attributes }}>
    <span class="product-rating__stars" role="img" aria-label="{{ 'products.rating_value' | t: rating: rating_value, max: 5 | escape }}">
      <span class="product-rating__track" aria-hidden="true">
        {% for star in (1..5) %}<img src="{{ 'product-rating-star.svg' | asset_url }}" alt="" width="18" height="18" loading="lazy">{% endfor %}
      </span>
      <span class="product-rating__fill" style="width: {{ rating_percentage }}%;" aria-hidden="true">
        {% for star in (1..5) %}<img src="{{ 'product-rating-star.svg' | asset_url }}" alt="" width="18" height="18" loading="lazy">{% endfor %}
      </span>
    </span>
    <span>{% if rating_count == 0 %}{{ 'products.review_count_zero' | t }}{% else %}{{ 'products.review_count' | t: count: rating_count }}{% endif %}</span>
  </div>
{% endif %}
{% stylesheet %}
.product-rating { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--body-color); }
.product-rating__stars { display: block; position: relative; width: 106px; height: 18px; flex: 0 0 106px; }
.product-rating__track, .product-rating__fill { display: flex; gap: 4px; }
.product-rating__track { filter: grayscale(1); opacity: .4; }
.product-rating__fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; }
.product-rating img { flex: 0 0 18px; display: block; }
{% endstylesheet %}
{% schema %}
{
  "name": "Product rating",
  "tag": null,
  "settings": [],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Product rating", "category": "t:general.product" }]
}
{% endschema %}
