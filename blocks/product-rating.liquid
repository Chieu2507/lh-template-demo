{% doc %}
  App-only review extension slot. Retains the legacy block type for saved layouts;
  the review app owns rating data, stars, copy and styling.
{% enddoc %}
{% capture review_app_content %}{% content_for 'blocks' %}{% endcapture %}
{% assign review_app_content = review_app_content | strip %}
{% if review_app_content != blank or request.design_mode %}
  <div class="product-review-app" {{ block.shopify_attributes }}>{{ review_app_content }}</div>
{% endif %}
{% schema %}
{
  "name": "Review app",
  "tag": null,
  "settings": [],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Review app", "category": "t:general.product" }]
}
{% endschema %}
