{% liquid
  assign item_collection = block.settings.collection
  assign item_title = block.settings.custom_title | default: item_collection.title | default: 'Collection title'
  assign item_image = block.settings.custom_image | default: item_collection.featured_image | default: item_collection.image
  assign item_id = block.id
  assign first_item = section.blocks | where: 'type', 'collections-with-tabs-item' | first
  assign first_item_id = first_item.id
  assign is_first_item = false
  if item_id == first_item_id
    assign is_first_item = true
  endif
  assign item_title_tag = section.settings.title_tag | default: 'div'
  unless item_title_tag == 'div' or item_title_tag == 'h1' or item_title_tag == 'h2' or item_title_tag == 'h3' or item_title_tag == 'h4' or item_title_tag == 'h5' or item_title_tag == 'h6'
    assign item_title_tag = 'div'
  endunless
  assign item_title_size = section.settings.title_size | default: 'xl'
  assign item_title_size = item_title_size | replace: 'heading_1', 'xl' | replace: 'heading_2', 'xl' | replace: 'heading_3', 'lg' | replace: 'heading_4', 'md'
  unless item_title_size == 'display' or item_title_size == 'xl' or item_title_size == 'lg' or item_title_size == 'md' or item_title_size == 'sm' or item_title_size == 'xs' or item_title_size == 'custom'
    assign item_title_size = 'xl'
  endunless
  assign custom_title_size = section.settings.custom_heading_size | default: 24 | plus: 0
  if custom_title_size < 10 or custom_title_size > 100
    assign custom_title_size = 24
  endif
  assign image_ratio = section.settings.image_ratio | default: 'auto'
  if image_ratio == 'auto'
    if item_image != blank and item_image.aspect_ratio > 0
      assign image_ratio = item_image.aspect_ratio
    else
      assign image_ratio = 1
    endif
  endif
%}
<div class="collections-with-tabs__item" {{ block.shopify_attributes }}>
<div class="collections-with-tabs__tab-row">
  <button id="CollectionsWithTabsTab-{{ item_id }}" class="collections-with-tabs__tab" type="button" role="tab" aria-controls="CollectionsWithTabsPanel-{{ item_id }}" aria-selected="{{ is_first_item }}" tabindex="{% if is_first_item %}0{% else %}-1{% endif %}" data-collections-with-tabs-tab data-collections-with-tabs-id="{{ item_id }}">
    <span class="collections-with-tabs__tab-content">
      <{{ item_title_tag }} class="collections-with-tabs__tab-title heading-text heading-{{ item_title_size }}"{% if item_title_size == 'custom' %} style="--heading-block-custom-size: {{ custom_title_size }}px"{% endif %}>{{ item_title | escape }}</{{ item_title_tag }}>
      {% if section.settings.show_product_count and item_collection != blank %}<sup class="collections-with-tabs__tab-count">{{ item_collection.products_count }}</sup>{% endif %}
    </span>
  </button>
  {% if item_collection != blank %}<a class="btn btn--primary btn--icon collections-with-tabs__tab-action" href="{{ item_collection.url }}" aria-label="View {{ item_title | escape }}">{% render 'icon', icon: 'arrow_up_right', bare: true %}</a>{% endif %}
</div>
<div id="CollectionsWithTabsPanel-{{ item_id }}" class="collections-with-tabs__panel{% if block.settings.color_type == 'color_scheme' %} color-scheme section-color-scope {{ block.settings.color_scheme | default: 'scheme-1' }}{% endif %}" role="tabpanel" aria-labelledby="CollectionsWithTabsTab-{{ item_id }}"{% unless is_first_item %} hidden{% endunless %} data-active="{{ is_first_item }}" data-collections-with-tabs-panel data-collections-with-tabs-id="{{ item_id }}">
    <div class="media collections-with-tabs__media{% if block.settings.custom_background %} collections-with-tabs__media--custom{% endif %}" style="--collections-with-tabs-panel-ratio: {{ image_ratio }}{% if block.settings.custom_background %};--collections-with-tabs-custom-background: {{ block.settings.background_color }}{% endif %}">
      <div class="media__inner{% if item_image == blank %} placeholder-image{% endif %}">
        {% if item_image != blank %}
          {{ item_image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(max-width: 767px) 100vw, 50vw', alt: item_title, loading: 'lazy' }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'collections-with-tabs__placeholder' }}
        {% endif %}
      </div>
      {% if section.settings.show_featured_products and item_collection != blank %}
        <div class="collections-with-tabs__featured" aria-label="Featured products">
          <span class="collections-with-tabs__featured-more" aria-hidden="true">+</span>
          {% for product in item_collection.products limit: section.settings.products_to_show %}
            <a class="media collections-with-tabs__featured-product{% if product.featured_image == blank %} placeholder-image{% endif %}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '40px', alt: product.title, loading: 'lazy' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
</div>
</div>
{% schema %}
{"name":"Collection","tag":null,"settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"custom_title","label":"Custom title"},{"type":"image_picker","id":"custom_image","label":"Custom image"},{"type":"header","content":"Color"},{"type":"select","id":"color_type","label":"Color type","options":[{"value":"inherit","label":"Inherit"},{"value":"color_scheme","label":"Color scheme"}],"default":"inherit"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1","visible_if":"{{ block.settings.color_type == 'color_scheme' }}"},{"type":"checkbox","id":"custom_background","label":"Custom background","default":false},{"type":"color","alpha":true,"id":"background_color","label":"Background color","default":"#f1f1f1","visible_if":"{{ block.settings.custom_background }}"}],"presets":[{"name":"Collection"}]}
{% endschema %}
