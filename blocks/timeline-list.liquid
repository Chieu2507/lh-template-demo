{% doc %}
  Renders the fixed-carousel timeline list. This list accepts Timeline Slide
  blocks only and reuses the shared Swiper viewport and navigation controls.
{% enddoc %}

{% liquid
  assign timeline_list_items = block.blocks | default: empty
  assign timeline_list_count = timeline_list_items.size
  assign timeline_list_carousel_id = 'TimelineCarousel-' | append: section.id | append: '-' | append: block.id
  assign timeline_list_aria_label = 'timeline.carousel_label' | t
  assign timeline_list_navigation_label = 'timeline.navigation_label' | t
  assign timeline_list_label_template = 'timeline.show_milestone' | t: year: '__TIMELINE_YEAR__'
  assign timeline_list_previous_label = 'timeline.previous' | t
  assign timeline_list_next_label = 'timeline.next' | t

  assign timeline_list_gap_desktop = block.settings.gap_desktop | default: 16 | plus: 0
  if timeline_list_gap_desktop < 0 or timeline_list_gap_desktop > 100
    assign timeline_list_gap_desktop = 16
  endif
  assign timeline_list_gap_mobile = block.settings.gap_mobile | default: 12 | plus: 0
  if timeline_list_gap_mobile < 0 or timeline_list_gap_mobile > 100
    assign timeline_list_gap_mobile = 12
  endif
  assign timeline_list_controls_spacing_desktop = block.settings.controls_spacing_desktop | default: 32 | plus: 0
  assign timeline_list_controls_spacing_mobile = block.settings.controls_spacing_mobile | default: 24 | plus: 0
  if timeline_list_controls_spacing_mobile > 40
    assign timeline_list_controls_spacing_mobile = 40
  endif

  assign timeline_list_preview = false
  if block.settings.show_next_slide_preview
    assign timeline_list_preview = true
  endif

  assign timeline_list_transition = block.settings.transition_style | default: 'slide'
  unless timeline_list_transition == 'slide' or timeline_list_transition == 'fade'
    assign timeline_list_transition = 'slide'
  endunless
  assign timeline_list_pagination_style = block.settings.pagination_style | default: 'dots_with_progress'
  case timeline_list_pagination_style
    when 'timeline'
      assign timeline_list_pagination_style = 'dots_with_progress'
    when 'text'
      assign timeline_list_pagination_style = 'tabs'
    when 'progress_bar'
      assign timeline_list_pagination_style = 'progress'
    when 'sliding_progress_bar'
      assign timeline_list_pagination_style = 'progress_slider'
    when 'inline_tabs'
      assign timeline_list_pagination_style = 'tabs'
  endcase
  unless timeline_list_pagination_style == 'dots' or timeline_list_pagination_style == 'dots_with_progress' or timeline_list_pagination_style == 'progress' or timeline_list_pagination_style == 'progress_slider' or timeline_list_pagination_style == 'tabs'
    assign timeline_list_pagination_style = 'dots_with_progress'
  endunless
  assign timeline_list_pagination_class = timeline_list_pagination_style | replace: '_', '-'
  assign timeline_list_navigation_position = block.settings.navigation_position | default: 'outside'
  unless timeline_list_navigation_position == 'outside' or timeline_list_navigation_position == 'inside'
    assign timeline_list_navigation_position = 'outside'
  endunless
  assign timeline_list_navigation_centered = false
  if timeline_list_navigation_position == 'inside'
    assign timeline_list_navigation_centered = true
  endif
  assign timeline_list_navigation_behavior = block.settings.navigation_behavior | default: 'show_on_hover'
  unless timeline_list_navigation_behavior == 'show_on_hover' or timeline_list_navigation_behavior == 'always'
    assign timeline_list_navigation_behavior = 'show_on_hover'
  endunless
  assign timeline_list_navigation_style = block.settings.navigation_style | default: 'secondary'
  unless timeline_list_navigation_style == 'primary' or timeline_list_navigation_style == 'secondary' or timeline_list_navigation_style == 'outline' or timeline_list_navigation_style == 'icon_only'
    assign timeline_list_navigation_style = 'secondary'
  endunless
  assign timeline_list_navigation_icon = block.settings.navigation_icon | default: 'chevron'
  unless timeline_list_navigation_icon == 'chevron' or timeline_list_navigation_icon == 'arrow' or timeline_list_navigation_icon == 'long_arrow'
    assign timeline_list_navigation_icon = 'chevron'
  endunless
  assign timeline_list_position = block.settings.position | default: 'bottom'
  unless timeline_list_position == 'left' or timeline_list_position == 'top' or timeline_list_position == 'bottom'
    assign timeline_list_position = 'bottom'
  endunless

  assign timeline_list_navigation_desktop = false
  if block.settings.show_navigation_on_desktop
    assign timeline_list_navigation_desktop = true
  endif
  assign timeline_list_show_navigation = timeline_list_navigation_desktop

  capture timeline_list_style
    echo '--timeline-list-controls-spacing-desktop: ' | append: timeline_list_controls_spacing_desktop | append: 'px;'
    echo '--timeline-list-controls-spacing-mobile: ' | append: timeline_list_controls_spacing_mobile | append: 'px;'
    if block.settings.active_color != blank
      echo '--timeline-list-active-color: ' | append: block.settings.active_color | append: ';'
    endif
    if block.settings.inactive_color != blank
      echo '--timeline-list-inactive-color: ' | append: block.settings.inactive_color | append: ';'
    endif
  endcapture
%}

<link rel="stylesheet" href="{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'swiper-12.2.0-effect-fade.min.css' | asset_url | stylesheet_tag }}</noscript>
{% unless request.design_mode %}
  <script type="module" src="{{ 'timeline-list.js' | asset_url }}"></script>
{% endunless %}

<div
  class="timeline-list"
  data-timeline-list
  data-timeline-position="{{ timeline_list_position }}"
  data-timeline-gap-desktop="{{ timeline_list_gap_desktop }}"
  data-timeline-gap-mobile="{{ timeline_list_gap_mobile }}"
  data-timeline-preview-desktop="{{ timeline_list_preview }}"
  data-timeline-preview-mobile="{{ timeline_list_preview }}"
  data-timeline-transition="{{ timeline_list_transition }}"
  data-timeline-navigation-desktop="{{ timeline_list_navigation_desktop }}"
  style="{{ timeline_list_style | strip | escape }}"
  {{ block.shopify_attributes }}
>
  {% if timeline_list_count > 0 %}
    {% capture timeline_list_slides %}{% content_for 'blocks' %}{% endcapture %}
    {% capture timeline_list_arrows %}
      {% render 'swiper-navigation',
        show: timeline_list_show_navigation,
        position: timeline_list_navigation_position,
        style: timeline_list_navigation_style,
        icon: timeline_list_navigation_icon,
        behavior: timeline_list_navigation_behavior,
        centered: timeline_list_navigation_centered,
        wrapper_class: 'timeline-list__arrows',
        wrapper_attributes: 'data-timeline-arrows hidden',
        previous_attribute: 'data-timeline-previous',
        next_attribute: 'data-timeline-next',
        previous_label: timeline_list_previous_label,
        next_label: timeline_list_next_label
      %}
    {% endcapture %}
    {% if timeline_list_navigation_position == 'inside' %}<div class="timeline-list__media swiper-carousel__container">{% endif %}
    {% render 'swiper-carousel',
      id: timeline_list_carousel_id,
      content: timeline_list_slides,
      root_class: 'timeline-list__viewport',
      root_attributes: 'data-timeline-carousel',
      aria_label: timeline_list_aria_label,
      show_next_slide_preview: timeline_list_preview,
      show_next_slide_preview_on_mobile: timeline_list_preview
    %}
    {% if timeline_list_navigation_position == 'inside' %}
      {{ timeline_list_arrows }}
    </div>{% endif %}

    <div class="timeline-list__controls" data-timeline-controls hidden>
      <nav
        class="timeline-list__navigation timeline-list__navigation--{{ timeline_list_pagination_class }} scrollbar{% if timeline_list_position == 'left' %} scrollbar--vertical{% else %} scrollbar--horizontal scrollbar--hidden-mobile{% endif %}"
        aria-label="{{ timeline_list_navigation_label | escape }}"
        data-timeline-navigation
        data-timeline-label-template="{{ timeline_list_label_template | escape }}"
        hidden
      >
        <ol class="timeline-list__navigation-list" data-timeline-navigation-list></ol>
      </nav>
      {% if timeline_list_navigation_position == 'outside' %}{{ timeline_list_arrows }}{% endif %}
    </div>
  {% elsif request.design_mode %}
    <p class="timeline-list__empty">{{ 'timeline.add_milestone' | t | escape }}</p>
  {% endif %}
</div>

{% render 'runtime-stylesheet', filename: 'component-runtime-blocks-timeline-list.css', section_index: section.index %}

