{% liquid
  assign width = block.settings.width_custom_desktop | default: 300
  assign mobile_width = block.settings.width_custom_mobile | default: 50
  if block.settings.size_desktop == '96' or block.settings.size_desktop == '128' or block.settings.size_desktop == '160' or block.settings.size_desktop == '208' or block.settings.size_desktop == '88'
    assign width = block.settings.size_desktop | plus: 0
  endif
  if block.settings.size_mobile == '96' or block.settings.size_mobile == '128' or block.settings.size_mobile == '160' or block.settings.size_mobile == '208' or block.settings.size_mobile == '88'
    assign mobile_width = block.settings.size_mobile | plus: 0
  endif
  capture ratio
    render 'image-ratio-value', setting: block.settings.image_ratio
  endcapture
  assign ratio = ratio | strip
  assign rotation = block.settings.rotate | default: 0 | at_least: -25 | at_most: 25
  assign rotation_abs = rotation | abs
  assign numeric_ratio = block.settings.image.aspect_ratio | default: 1
  if ratio contains '/'
    assign ratio_parts = ratio | split: '/'
    assign numerator = ratio_parts.first | plus: 0.0
    assign denominator = ratio_parts.last | plus: 0.0
    assign numeric_ratio = numerator | divided_by: denominator
  endif
  assign marquee_corner_radius = block.settings.corner_radius | default: 'square'
  assign marquee_custom_corner_radius = block.settings.custom_corner_radius | default: 0 | plus: 0
  unless marquee_corner_radius == 'inherit' or marquee_corner_radius == 'square' or marquee_corner_radius == 'rounded' or marquee_corner_radius == 'full' or marquee_corner_radius == 'custom' or marquee_corner_radius == 'radius_2' or marquee_corner_radius == 'radius_4' or marquee_corner_radius == 'radius_6' or marquee_corner_radius == 'radius_8' or marquee_corner_radius == 'radius_12' or marquee_corner_radius == 'radius_16' or marquee_corner_radius == 'radius_24' or marquee_corner_radius == 'radius_32'
    assign marquee_legacy_corner_radius = marquee_corner_radius | plus: 0
    if marquee_legacy_corner_radius > 0
      assign marquee_corner_radius = 'custom'
      assign marquee_custom_corner_radius = marquee_legacy_corner_radius
      if marquee_custom_corner_radius > 40
        assign marquee_custom_corner_radius = 40
      endif
    else
      assign marquee_corner_radius = 'square'
    endif
  endunless

  if marquee_custom_corner_radius < 0 or marquee_custom_corner_radius > 40
    assign marquee_custom_corner_radius = 0
  endif

  assign radius = 'var(--media-radius, var(--radius-square))'
  case marquee_corner_radius
    when 'radius_2', 'radius_4', 'radius_6', 'radius_8', 'radius_12', 'radius_16', 'radius_24', 'radius_32'
      assign radius = marquee_corner_radius | replace: 'radius_', 'var(--radius-' | append: ')'
    when 'square'
      assign radius = 'var(--radius-square)'
    when 'rounded'
      assign radius = 'var(--radius-rounded)'
    when 'full'
      assign radius = 'var(--radius-pill)'
    when 'custom'
      assign radius = marquee_custom_corner_radius | append: 'px'
  endcase

  capture sizes
    echo '(max-width:767px) '
    echo mobile_width
    echo 'px, '
    echo width
    echo 'px'
  endcapture
  assign responsive_max_width = width | at_least: mobile_width | times: 3 | at_most: 800
%}
<div class="marquee-image-block{% if rotation != 0 %} marquee-image-block--rotated{% endif %}" style="--mq-image-width:{{ width }}px;{% if block.settings.image_fit == 'contain' %}--mq-image-fit:contain;--mq-image-scale:{{ block.settings.image_scale | default: 100 | divided_by: 100.0 }};{% endif %}--mq-image-width-mobile:{{ mobile_width }}px;--mq-image-ratio:{{ ratio }};--mq-image-radius:{{ radius }};{% if rotation != 0 %}--mq-image-rotation:{{ rotation }}deg;--mq-image-rotation-abs:{{ rotation_abs }}deg;--mq-image-aspect:{{ numeric_ratio }};{% endif %}" {{ block.shopify_attributes }}>
  {% if rotation != 0 %}<div class="marquee-image-block__media">{% endif %}
    {% render 'image', image: block.settings.image, url: block.settings.image_link, open_in_new_tab: block.settings.open_in_new_tab, width: responsive_max_width, widths: '36,50,72,88,100,132,176,208,264,312,416,528,624,800', sizes: sizes, auto_sizes: false %}
  {% if rotation != 0 %}</div>{% endif %}
</div>
{% stylesheet %}
  .marquee-image-block { flex: 0 0 auto; --mq-image-active-width: var(--mq-image-width); width: var(--mq-image-active-width); border-radius: var(--mq-image-radius); overflow: hidden; }
  .marquee-image-block .image { aspect-ratio: var(--mq-image-ratio); }
  .marquee-image-block .image > img,
  .marquee-image-block .image > svg { width: 100%; height: 100%; object-fit:var(--mq-image-fit,cover);transform:scale(var(--mq-image-scale,1)); }
  /* Reserve the rotated media's bounds so the marquee gap and loop stay accurate. */
  .marquee-image-block--rotated {
    display: grid;
    place-items: center;
    width: calc(var(--mq-image-active-width) * cos(var(--mq-image-rotation-abs)) + var(--mq-image-active-width) / var(--mq-image-aspect) * sin(var(--mq-image-rotation-abs)));
    height: calc(var(--mq-image-active-width) / var(--mq-image-aspect) * cos(var(--mq-image-rotation-abs)) + var(--mq-image-active-width) * sin(var(--mq-image-rotation-abs)));
    border-radius: 0;
    overflow: visible;
  }
  .marquee-image-block__media { grid-area: 1 / 1; width: var(--mq-image-active-width); aspect-ratio: var(--mq-image-aspect); transform: rotate(var(--mq-image-rotation)); border-radius: var(--mq-image-radius); overflow: hidden; }
  .marquee-image-block__media .image { width: 100%; height: 100%; }
  @media (max-width: 767.98px) { .marquee-image-block { --mq-image-active-width: var(--mq-image-width-mobile); } }
{% endstylesheet %}

