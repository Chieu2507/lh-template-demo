{% doc %}
  Renders a media-led card with a responsive background and controlled content blocks.

  @example
  {% content_for 'block', type: 'image-card', id: 'image-card' %}
{% enddoc %}

{% capture image_card_children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'media-card',
  media_card_block: block,
  children: image_card_children
%}

{% schema %}
{
  "name": "t:general.image_card",
  "tag": null,
  "blocks": [
    { "type": "eyebrow" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" },
    { "type": "buttons" },
    { "type": "icon" },
    { "type": "header" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:labels.open_in_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "t:labels.type",
      "options": [
        { "value": "image", "label": "t:general.image" },
        { "value": "video", "label": "t:general.video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image",
      "visible_if": "{{ block.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "t:labels.mobile_video",
      "visible_if": "{{ block.settings.background_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:labels.show_overlay",
      "default": false
    },
    {
      "type": "header",
      "content": "t:general.size"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:labels.device",
      "options": [
        { "value": "desktop", "label": "t:options.device.desktop" },
        { "value": "mobile", "label": "t:options.device.mobile" }
      ],
      "default": "desktop"
    },
    {
      "type": "select",
      "id": "width_desktop",
      "label": "t:labels.width",
      "options": [
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "custom", "label": "t:options.width.custom" }
      ],
      "default": "fill",
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "width_custom_desktop",
      "label": "t:labels.custom_width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.width_desktop == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "limit_width_desktop",
      "label": "t:labels.limit_width",
      "default": false,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "max_width_desktop",
      "label": "t:labels.max_width",
      "min": 0,
      "max": 1600,
      "step": 16,
      "unit": "px",
      "default": 1600,
      "visible_if": "{{ block.settings.device == 'desktop' and block.settings.limit_width_desktop }}"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "t:labels.height",
      "options": [
        { "value": "adapt", "label": "t:options.image_card_height.adapt" },
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "ratio_1_1", "label": "t:options.image_card_height.ratio_1_1" },
        { "value": "ratio_4_5", "label": "t:options.image_card_height.ratio_4_5" },
        { "value": "ratio_3_2", "label": "t:options.image_card_height.ratio_3_2" },
        { "value": "ratio_4_3", "label": "t:options.image_card_height.ratio_4_3" },
        { "value": "ratio_16_9", "label": "t:options.image_card_height.ratio_16_9" },
        { "value": "ratio_2_3", "label": "t:options.image_card_height.ratio_2_3" },
        { "value": "ratio_3_4", "label": "t:options.image_card_height.ratio_3_4" },
        { "value": "ratio_9_16", "label": "t:options.image_card_height.ratio_9_16" }
      ],
      "default": "ratio_1_1",
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:labels.width_mobile",
      "options": [
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "custom", "label": "t:options.width.custom" }
      ],
      "default": "fill",
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "width_custom_mobile",
      "label": "t:labels.custom_width_mobile",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "limit_width_mobile",
      "label": "t:labels.limit_width_mobile",
      "default": false,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "label": "t:labels.max_width_mobile",
      "min": 0,
      "max": 1600,
      "step": 16,
      "unit": "px",
      "default": 1600,
      "visible_if": "{{ block.settings.device == 'mobile' and block.settings.limit_width_mobile }}"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:labels.mobile_height",
      "options": [
        { "value": "adapt", "label": "t:options.image_card_height.adapt" },
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "ratio_1_1", "label": "t:options.image_card_height.ratio_1_1" },
        { "value": "ratio_4_5", "label": "t:options.image_card_height.ratio_4_5" },
        { "value": "ratio_3_2", "label": "t:options.image_card_height.ratio_3_2" },
        { "value": "ratio_4_3", "label": "t:options.image_card_height.ratio_4_3" },
        { "value": "ratio_16_9", "label": "t:options.image_card_height.ratio_16_9" },
        { "value": "ratio_2_3", "label": "t:options.image_card_height.ratio_2_3" },
        { "value": "ratio_3_4", "label": "t:options.image_card_height.ratio_3_4" },
        { "value": "ratio_9_16", "label": "t:options.image_card_height.ratio_9_16" }
      ],
      "default": "ratio_1_1",
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "select",
      "id": "position_desktop",
      "label": "t:labels.desktop_position",
      "options": [
        { "value": "top_left", "label": "Top left" },
        { "value": "top_center", "label": "Top center" },
        { "value": "top_right", "label": "Top right" },
        { "value": "center_left", "label": "Center left" },
        { "value": "center_center", "label": "Center center" },
        { "value": "center_right", "label": "Center right" },
        { "value": "bottom_left", "label": "Bottom left" },
        { "value": "bottom_center", "label": "Bottom center" },
        { "value": "bottom_right", "label": "Bottom right" }
      ],
      "default": "top_center"
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "t:labels.mobile_position",
      "options": [
        { "value": "top_left", "label": "Top left" },
        { "value": "top_center", "label": "Top center" },
        { "value": "top_right", "label": "Top right" },
        { "value": "center_left", "label": "Center left" },
        { "value": "center_center", "label": "Center center" },
        { "value": "center_right", "label": "Center right" },
        { "value": "bottom_left", "label": "Bottom left" },
        { "value": "bottom_center", "label": "Bottom center" },
        { "value": "bottom_right", "label": "Bottom right" }
      ],
      "default": "top_center"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:general.border"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:labels.corner_radius",
      "options": [
        { "value": "square", "label": "t:options.radius_preset.square" },
        { "value": "slightly_rounded", "label": "t:options.radius_preset.slightly_rounded" },
        { "value": "rounded", "label": "t:options.radius_preset.rounded" },
        { "value": "pill", "label": "t:options.radius_preset.pill" }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:labels.mobile_left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:labels.mobile_right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_card",
      "category": "t:general.cards",
      "settings": {
        "color_scheme": "scheme-3",
        "padding_top": 32,
        "padding_bottom": 32,
        "padding_left": 32,
        "padding_right": 32
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": {
            "text": "<p>Eyebrow</p>"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>Heading</p>",
            "heading_size": "lg",
            "html_tag": "h2"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Button label",
            "button_style": "primary",
            "button_open_in_new_tab": false,
            "show_icon": false,
            "icon": "arrow",
            "icon_position": "after",
            "icon_size": "inherit",
            "icon_width": 20,
            "width": "fit",
            "width_mobile": "fit",
            "customize_mobile_padding": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
