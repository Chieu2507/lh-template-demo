{% doc %}
  Renders links to the previous and next articles in the current blog.
{% enddoc %}
{% capture synced_title_size %}{% render 'heading-size-token', size: block.settings.title_size, fallback: 'sm' %}{% endcapture %}
{% assign synced_title_size = synced_title_size | strip %}

<nav class="article-pagination article-pagination--{{ block.settings.corner_radius | default: 'inherit' }}" aria-label="Article navigation" style="--article-pagination-title-size:var(--font-heading-{{ synced_title_size }});--article-pagination-title-line-height:var(--font-heading-{{ synced_title_size }}-line-height);--article-pagination-padding-top: {{ block.settings.padding_top }}px; --article-pagination-padding-bottom: {{ block.settings.padding_bottom }}px; --article-pagination-padding-top-mobile: {{ block.settings.padding_top_mobile }}px; --article-pagination-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;" {{ block.shopify_attributes }}>
  {% if blog.previous_article %}<a class="article-pagination__item article-pagination__item--previous" href="{{ blog.previous_article.url }}">Previous Post</a>{% endif %}
  {% if blog.next_article %}<a class="article-pagination__item article-pagination__item--next" href="{{ blog.next_article.url }}">Next Post</a>{% endif %}
</nav>

{% render 'runtime-stylesheet', filename: 'component-runtime-blocks-previous-and-next-posts.css', section_index: section.index %}

{% schema %}
{
  "name": "Previous and next posts",
  "tag": null,
  "settings": [
    {"type":"select","id":"title_size","label":"Title size","options":[{"value":"display","label":"t:options.heading_size.display"},{"value":"xl","label":"t:options.heading_size.xl"},{"value":"lg","label":"t:options.heading_size.lg"},{"value":"md","label":"t:options.heading_size.md"},{"value":"sm","label":"t:options.heading_size.sm"},{"value":"xs","label":"t:options.heading_size.xs"}],"default":"sm"},
    { "type": "select", "id": "corner_radius", "label": "Corner radius", "options": [{ "value": "inherit", "label": "Inherit" }, { "value": "square", "label": "Square" }, { "value": "rounded", "label": "Rounded" }, { "value": "custom", "label": "Custom" }], "default": "inherit" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "custom_mobile_padding", "label": "Custom for mobile", "default": false },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.custom_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.custom_mobile_padding }}" }
  ]
}
{% endschema %}
