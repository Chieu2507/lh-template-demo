{% doc %}
  Composes two fixed Image children into an adjustable overlapping canvas.
  Images owns canvas geometry; Image owns media, ratios, links, radius and padding.
  First is rendered before second in the reading and keyboard order.
{% enddoc %}

{% liquid
  assign canvas_height = 540
  if block.settings.height != 'fill'
    assign canvas_height = block.settings.height_desktop | default: 540 | at_least: 100 | at_most: 2000
  endif
  assign canvas_height_mobile = canvas_height
  assign canvas_reference_width_mobile = 780
  if block.settings.customize_mobile
    assign canvas_height_mobile = block.settings.height_mobile | default: 300 | at_least: 100 | at_most: 1000
    assign canvas_reference_width_mobile = 343
  endif
  assign canvas_width = '100%'
  if block.settings.width_desktop == 'custom'
    assign canvas_width = block.settings.width_custom_desktop | default: 100 | at_least: 10 | at_most: 100 | append: '%'
  elsif block.settings.width_desktop == 'fit'
    assign canvas_width = 'min(100%, 780px)'
  endif
  assign canvas_width_mobile = canvas_width
  if block.settings.customize_mobile
    assign canvas_width_mobile = '100%'
    if block.settings.width_mobile == 'custom'
      assign canvas_width_mobile = block.settings.width_custom_mobile | default: 100 | at_least: 10 | at_most: 100 | append: '%'
    elsif block.settings.width_mobile == 'fit'
      assign canvas_width_mobile = 'min(100%, 343px)'
    endif
  endif
  assign canvas_max_width = '100%'
  if block.settings.limit_width_desktop
    assign canvas_max_width = block.settings.max_width_desktop | default: 1600 | at_least: 1 | at_most: 1600 | append: 'px'
  endif
  assign canvas_max_width_mobile = canvas_max_width
  if block.settings.customize_mobile
    assign canvas_max_width_mobile = '100%'
    if block.settings.limit_width_mobile
      assign canvas_max_width_mobile = block.settings.max_width_mobile | default: 1600 | at_least: 1 | at_most: 1600 | append: 'px'
    endif
  endif
%}
{% capture canvas_style %}
  {% render 'size-style', width: canvas_width, width_mobile: canvas_width_mobile, max_width: canvas_max_width, max_width_mobile: canvas_max_width_mobile %}
  --images-ratio: 780 / {{ canvas_height }};
  --images-ratio-mobile: {{ canvas_reference_width_mobile }} / {{ canvas_height_mobile }};
  {% for side in (1..4) %}
    {% liquid
      case side
        when 1
          assign edge = 'top'
        when 2
          assign edge = 'right'
        when 3
          assign edge = 'bottom'
        when 4
          assign edge = 'left'
      endcase
      assign padding_key = 'padding_' | append: edge
      assign padding_value = block.settings[padding_key] | default: 0 | at_least: 0 | at_most: 100
    %}
    {% if padding_value != 0 %}--images-padding-{{ edge }}: {{ padding_value }}px;{% endif %}
    {% if block.settings.customize_mobile_padding %}
      {% assign mobile_padding_key = padding_key | append: '_mobile' %}
      --images-padding-{{ edge }}-mobile: {{ block.settings[mobile_padding_key] | default: 0 | at_least: 0 | at_most: 100 }}px;
    {% endif %}
  {% endfor %}
{% endcapture %}
<div class="images-block size-style{% if block.settings.height == 'fill' %} images-block--height-fill{% endif %}{% if block.settings.customize_mobile %} images-block--mobile-custom-size{% endif %} images-block--front-{{ block.settings.front_image | default: 'first' }}" style="{{ canvas_style | strip }}" {{ block.shopify_attributes }}>
  <div class="images-block__canvas">
    {% for index in (1..2) %}
      {% liquid
        assign slot = 'first'
        if index == 2
          assign slot = 'second'
        endif
        assign mobile_toggle_key = slot | append: '_customize_mobile'
        assign slot_customize_mobile = block.settings[mobile_toggle_key]
        if slot_customize_mobile == nil
          assign slot_customize_mobile = block.settings.customize_mobile
        endif
      %}
      {% capture slot_style %}
        {% for device_index in (1..2) %}
          {% liquid
            assign device = 'desktop'
            if device_index == 2 and slot_customize_mobile
              assign device = 'mobile'
            endif
            assign key = slot | append: '_width_' | append: device
            assign slot_width = block.settings[key] | default: 50 | at_least: 10 | at_most: 100
            assign key = slot | append: '_left_' | append: device
            assign slot_left = block.settings[key] | default: 0 | at_least: 0 | at_most: 100
            assign key = slot | append: '_top_' | append: device
            assign slot_top = block.settings[key] | default: 0 | at_least: 0 | at_most: 100
            assign key = slot | append: '_anchor_' | append: device
            assign slot_translate = '0%'
            if block.settings[key] == 'center'
              assign slot_translate = '-50%'
            elsif block.settings[key] == 'bottom'
              assign slot_translate = '-100%'
            endif
          %}
          --slot-width-{{ device_index }}: {{ slot_width }}%;
          --slot-left-{{ device_index }}: {{ slot_left }}%;
          --slot-top-{{ device_index }}: {{ slot_top }}%;
          --slot-translate-{{ device_index }}: {{ slot_translate }};
        {% endfor %}
      {% endcapture %}
      <div class="images-block__slot images-block__slot--{{ slot }}" style="{{ slot_style | strip }}">
        {% if index == 1 %}
          {% content_for 'block', type: 'image', id: 'first' %}
        {% else %}
          {% content_for 'block', type: 'image', id: 'second' %}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .images-block {
    min-width: 0;
    padding: min(var(--images-padding-top, 0px), 25%) min(var(--images-padding-right, 0px), 25%) min(var(--images-padding-bottom, 0px), 25%) min(var(--images-padding-left, 0px), 25%);
  }
  .images-block__canvas {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: auto;
    aspect-ratio: var(--images-ratio, 780 / 540);
    overflow: clip;
    overflow-clip-margin: 4px;
  }
  .images-block__slot {
    position: absolute;
    width: var(--slot-width-1, 50%);
    left: min(var(--slot-left-1, 0%), calc(100% - var(--slot-width-1, 50%)));
    top: var(--slot-top-1, 0%);
    transform: translateY(var(--slot-translate-1, 0%));
  }
  .images-block--front-first .images-block__slot--first,
  .images-block--front-second .images-block__slot--second { z-index: 1; }
  .images-block__slot:focus-within { z-index: 2; }
  .images-block__slot > .image-block { max-width: 100%; }
  @media (min-width: 768px) {
    .images-block--height-fill { display: flex; flex-direction: column; align-self: stretch; }
    .images-block--height-fill > .images-block__canvas { flex: 1 1 auto; min-height: 0; }
    .images-block__slot:has(> .image-block--ratio-desktop-fill_height) { height: 100%; }
  }
  @media (max-width: 767.98px) {
    .images-block--height-fill:not(.images-block--mobile-custom-size) { display: flex; flex-direction: column; align-self: stretch; }
    .images-block--height-fill:not(.images-block--mobile-custom-size) > .images-block__canvas { flex: 1 1 auto; min-height: 0; }
    .images-block__slot:has(> .image-block--ratio-mobile-fill_height) { height: 100%; }
    .images-block { padding: min(var(--images-padding-top-mobile, var(--images-padding-top, 0px)), 25%) min(var(--images-padding-right-mobile, var(--images-padding-right, 0px)), 25%) min(var(--images-padding-bottom-mobile, var(--images-padding-bottom, 0px)), 25%) min(var(--images-padding-left-mobile, var(--images-padding-left, 0px)), 25%); }
    .images-block__canvas { aspect-ratio: var(--images-ratio-mobile, var(--images-ratio, 780 / 540)); }
    .images-block__slot {
      width: var(--slot-width-2, var(--slot-width-1, 50%));
      left: min(var(--slot-left-2, var(--slot-left-1, 0%)), calc(100% - var(--slot-width-2, var(--slot-width-1, 50%))));
      top: var(--slot-top-2, var(--slot-top-1, 0%));
      transform: translateY(var(--slot-translate-2, var(--slot-translate-1, 0%)));
    }
  }
{% endstylesheet %}

