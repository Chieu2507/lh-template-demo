{% doc %}
  Private compact product recommendation for testimonial cards. Product picker
  owns the resource; image, title and market-aware price remain Shopify data.
{% enddoc %}
{% assign compact_product = block.settings.product %}
<div class="product-card-compact" {{ block.shopify_attributes }}>
  {% if compact_product != blank %}
    <a class="product-card-compact__link" href="{{ compact_product.url }}">
      <span class="product-card-compact__media">
        {% if compact_product.featured_image != blank %}
          {{ compact_product.featured_image | image_url: width: 192 | image_tag: widths: '64,128,192', sizes: '64px', loading: 'lazy', alt: compact_product.title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </span>
      <span class="product-card-compact__content">
        <span class="product-card-compact__title">{{ compact_product.title | escape }}</span>
        {% if block.settings.show_price %}{% render 'price', item: compact_product, context: 'product-card' %}{% endif %}
      </span>
    </a>
  {% else %}
    <div class="product-card-compact__link">
      <span class="product-card-compact__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
      <span class="product-card-compact__content">
        <span class="product-card-compact__title">{{ 'products.product_title' | t }}</span>
        {% if block.settings.show_price %}{% render 'price', amount: 1900, context: 'product-card' %}{% endif %}
      </span>
    </div>
  {% endif %}
</div>
{% stylesheet %}
.product-card-compact { width: 100%; min-width: 0; }
.product-card-compact__link { display: flex; align-items: center; gap: 16px; color: var(--heading-color); text-decoration: none; min-width: 0; }
.product-card-compact__media { flex: 0 0 64px; width: 64px; height: 64px; overflow: hidden; border-radius: 4px; }
.product-card-compact__media img, .product-card-compact__media svg { display: block; width: 100%; height: 100%; object-fit: cover; }
.product-card-compact__content { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
.product-card-compact__title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--product-card-title-font-family, var(--font-body-family)); font-size: 16px; font-weight: 600; line-height: 1.5; }
.product-card-compact .price { font-size: 16px; font-weight: 600; line-height: 1.5; }
{% endstylesheet %}

{% schema %}
{
  "name": "Product card: Compact",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:labels.show_price",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product card: Compact"
    }
  ]
}
{% endschema %}
