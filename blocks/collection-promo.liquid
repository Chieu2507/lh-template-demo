{% doc %}
  Repeatable editorial card in the collection product grid.
  Content fields and media controls stay on this block so each promo card can be
  added, removed, reordered and edited independently in the Theme Editor.
{% enddoc %}
{% liquid
  assign promo_scheme = block.settings.color_scheme.id | default: block.settings.color_scheme | default: 'scheme-1'
  assign promo_position = block.settings.position | default: 5 | plus: 0
  assign promo_columns_desktop = block.settings.columns_desktop | default: '2'
  assign promo_columns_mobile = block.settings.columns_mobile | default: '2'
  assign promo_alignment = block.settings.content_alignment | default: 'center'
  assign promo_position_y = block.settings.content_position | default: 'center'
  assign promo_media_type = block.settings.media_type | default: 'image'
  assign promo_text_size = block.settings.text_size | default: 'md'
  assign promo_heading_size = block.settings.heading_size | default: 'h2'
  assign promo_heading_scale = 'xl'
  assign promo_heading_level = 2

  case promo_heading_size
    when 'h1'
      assign promo_heading_scale = 'display'
      assign promo_heading_level = 1
    when 'h2'
      assign promo_heading_scale = 'xl'
      assign promo_heading_level = 2
    when 'h3'
      assign promo_heading_scale = 'lg'
      assign promo_heading_level = 3
    when 'h4'
      assign promo_heading_scale = 'md'
      assign promo_heading_level = 4
    when 'h5'
      assign promo_heading_scale = 'sm'
      assign promo_heading_level = 5
    when 'h6'
      assign promo_heading_scale = 'xs'
      assign promo_heading_level = 6
    else
      assign promo_heading_size = 'h2'
      assign promo_heading_scale = 'xl'
      assign promo_heading_level = 2
  endcase

  unless promo_text_size == 'xs' or promo_text_size == 'sm' or promo_text_size == 'md' or promo_text_size == 'lg' or promo_text_size == 'xl'
    assign promo_text_size = 'md'
  endunless

  assign promo_alignment_items = 'center'
  assign promo_alignment_text = 'center'
  assign promo_justify = 'center'
  case promo_alignment
    when 'left'
      assign promo_alignment_items = 'flex-start'
      assign promo_alignment_text = 'left'
    when 'right'
      assign promo_alignment_items = 'flex-end'
      assign promo_alignment_text = 'right'
  endcase
  case promo_position_y
    when 'top'
      assign promo_justify = 'flex-start'
    when 'bottom'
      assign promo_justify = 'flex-end'
  endcase

  assign promo_padding_block_mobile = block.settings.padding_top_bottom | default: 40 | divided_by: 2
  assign promo_padding_inline_mobile = block.settings.padding_left_right | default: 28 | divided_by: 2
  if block.settings.customize_mobile_padding
    assign promo_padding_block_mobile = block.settings.padding_top_bottom_mobile | default: 24
    assign promo_padding_inline_mobile = block.settings.padding_left_right_mobile | default: 16
  endif

  assign promo_button_style = block.settings.button_style | default: 'primary'
  assign promo_button_variant = 'primary'
  case promo_button_style
    when 'secondary', 'outline', 'subtle'
      assign promo_button_variant = 'secondary'
    when 'text'
      assign promo_button_variant = 'tertiary'
    when 'primary'
      assign promo_button_variant = 'primary'
    else
      assign promo_button_style = 'primary'
      assign promo_button_variant = 'primary'
  endcase

  assign promo_button_height = 'var(--button-height)'
  assign promo_button_height_mobile = 'var(--button-height-mobile)'
  case block.settings.button_height
    when 'extra_small'
      assign promo_button_height = '36px'
      assign promo_button_height_mobile = '36px'
    when 'small'
      assign promo_button_height = '40px'
      assign promo_button_height_mobile = '40px'
    when 'medium'
      assign promo_button_height = '48px'
      assign promo_button_height_mobile = '48px'
    when 'large'
      assign promo_button_height = '56px'
      assign promo_button_height_mobile = '56px'
    when 'extra_large'
      assign promo_button_height = '64px'
      assign promo_button_height_mobile = '64px'
  endcase

  assign promo_button_class = 'main-collection__promotion-button main-collection__promotion-button--' | append: promo_button_style
  assign promo_icon = blank
  if block.settings.show_icon
    assign promo_icon = block.settings.icon | default: 'arrow'
  endif

  assign promo_subheading_text = block.settings.subheading | strip_html | strip
  assign promo_heading_text = block.settings.heading | strip_html | strip
  assign promo_body_text = block.settings.text | strip_html | strip
%}
<li
  class="main-collection__promotion color-scheme section-color-scope {{ promo_scheme }}"
  style="order:{{ promo_position | times: 10 | minus: 5 }};--promo-span:{{ promo_columns_desktop }};--promo-span-mobile:{{ promo_columns_mobile }};--promo-overlay:{{ block.settings.overlay_opacity | default: 20 | divided_by: 100.0 }};--promo-overlay-color:{{ block.settings.overlay_color | default: '#000000' }};--promo-content-gap:{{ block.settings.content_gap | default: 12 }}px;--promo-button-spacing:{{ block.settings.button_spacing | default: 24 }}px;--promo-padding-block:{{ block.settings.padding_top_bottom | default: 40 }}px;--promo-padding-inline:{{ block.settings.padding_left_right | default: 28 }}px;--promo-padding-block-mobile:{{ promo_padding_block_mobile }}px;--promo-padding-inline-mobile:{{ promo_padding_inline_mobile }}px;--promo-alignment-items:{{ promo_alignment_items }};--promo-alignment-text:{{ promo_alignment_text }};--promo-position:{{ promo_justify }}"
  {{ block.shopify_attributes }}
>
  <div class="main-collection__promotion-card">
    <div class="main-collection__promotion-media">
      {% if promo_media_type == 'video' and block.settings.video != blank %}
        {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'main-collection__promotion-image', preload: 'metadata' }}
      {% elsif block.settings.image != blank %}
        <picture>
          {% if block.settings.mobile_image != blank %}
            <source media="(max-width: 767.98px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">
          {% endif %}
          {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400, 800, 1200, 1600', sizes: '(min-width: 1150px) 50vw, 100vw', loading: 'lazy', class: 'main-collection__promotion-image' }}
        </picture>
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'main-collection__promotion-image' }}
      {% endif %}
    </div>
    {% if block.settings.show_overlay %}
      <span class="main-collection__promotion-overlay" aria-hidden="true"></span>
    {% endif %}
    {% if block.settings.card_link != blank %}
      <a
        class="main-collection__promotion-hit-area"
        href="{{ block.settings.card_link | escape }}"
        aria-label="{{ 'collection.promo_link' | t | escape }}"
        {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
      ></a>
    {% endif %}
    <div class="main-collection__promotion-content">
      {% if promo_subheading_text != blank %}
        <div class="main-collection__promotion-subheading eyebrow-text body-text body-sm">{{ block.settings.subheading }}</div>
      {% endif %}
      {% if promo_heading_text != blank %}
        <div class="main-collection__promotion-heading heading-text heading-{{ promo_heading_scale }}" role="heading" aria-level="{{ promo_heading_level }}">{{ block.settings.heading }}</div>
      {% endif %}
      {% if promo_body_text != blank %}
        <div class="main-collection__promotion-text body-text body-{{ promo_text_size }}">{{ block.settings.text }}</div>
      {% endif %}
      {% if block.settings.button_label != blank %}
        <div
          class="main-collection__promotion-cta{% if block.settings.button_full_width %} main-collection__promotion-cta--full-width{% endif %}"
          style="--promo-button-height:{{ promo_button_height }};--promo-button-height-mobile:{{ promo_button_height_mobile }}"
        >
          {% render 'theme-button',
            label: block.settings.button_label,
            url: block.settings.card_link,
            open_in_new_tab: block.settings.open_in_new_tab,
            variant: promo_button_variant,
            icon: promo_icon,
            class: promo_button_class
          %}
        </div>
      {% endif %}
    </div>
  </div>
</li>

{% stylesheet %}
  .main-collection__promotion-subheading,
  .main-collection__promotion-heading,
  .main-collection__promotion-text {
    width: 100%;
    margin: 0;
  }

  .main-collection__promotion-subheading :where(p),
  .main-collection__promotion-heading :where(p),
  .main-collection__promotion-text :where(p) {
    margin: 0;
  }

  .main-collection__promotion-cta {
    position: relative;
    z-index: 3;
    width: fit-content;
    max-width: 100%;
    margin-top: var(--promo-button-spacing, 24px);
    pointer-events: auto;
  }

  .main-collection__promotion-cta .main-collection__promotion-button {
    min-height: var(--promo-button-height, var(--button-height));
  }

  .main-collection__promotion-cta--full-width {
    width: 100%;
  }

  .main-collection__promotion-cta--full-width .main-collection__promotion-button {
    width: 100%;
  }

  .main-collection__promotion-button--outline {
    --button-background: transparent;
    --button-foreground: var(--button-secondary-text);
    --button-border: var(--button-secondary-border);
  }

  .main-collection__promotion-button--subtle {
    --button-background: color-mix(in srgb, var(--button-secondary-background) 40%, transparent);
    --button-foreground: var(--button-secondary-text);
    --button-border: transparent;
    --button-hover-background: var(--button-secondary-background);
  }

  @media (max-width: 767.98px) {
    .main-collection__promotion-cta {
      margin-top: var(--promo-button-spacing, 16px);
    }

    .main-collection__promotion-cta .main-collection__promotion-button {
      min-height: var(--promo-button-height-mobile, var(--button-height-mobile));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo card",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "position",
      "label": "Card position",
      "min": 1,
      "max": 40,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "url", "id": "card_link", "label": "Card link" },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    { "type": "header", "content": "Media" },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "alpha": true,
      "default": "#000000",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "unit": "%",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    { "type": "header", "content": "Content" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>[ Save 20% off ]</p>"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Curate Your Set</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p></p>"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Typography" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "xs", "label": "Extra small" },
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "md"
    },
    { "type": "header", "content": "Button" },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Curate now"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "text", "label": "Text" }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "arrow", "label": "Arrow" },
        { "value": "cart", "label": "Cart" }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "select",
      "id": "button_height",
      "label": "Height",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "extra_small", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra_large", "label": "Extra large" }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "button_full_width",
      "label": "Full width",
      "default": false
    },
    { "type": "header", "content": "Gap" },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Button spacing",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    { "type": "header", "content": "Appearance" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top_bottom",
      "label": "Top and bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left_right",
      "label": "Left and right",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom for mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_bottom_mobile",
      "label": "Mobile top and bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 24,
      "unit": "px",
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_right_mobile",
      "label": "Mobile left and right",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 16,
      "unit": "px",
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Promo card",
      "settings": {
        "position": 5,
        "columns_desktop": "2",
        "columns_mobile": "2",
        "media_type": "image",
        "show_overlay": true,
        "overlay_color": "#000000",
        "overlay_opacity": 20,
        "subheading": "<p>[ Save 20% off ]</p>",
        "heading": "<p>Curate Your Set</p>",
        "heading_size": "h2",
        "text_size": "md",
        "button_label": "Curate now",
        "button_style": "primary",
        "color_scheme": "scheme-1",
        "padding_top_bottom": 40,
        "padding_left_right": 28,
        "customize_mobile_padding": true,
        "padding_top_bottom_mobile": 24,
        "padding_left_right_mobile": 16
      }
    }
  ]
}
{% endschema %}
