{% doc %}
  Responsive column switcher. Choice is preserved when facets refresh.
{% enddoc %}
<fieldset class="collection-columns" data-desktop-type="{{ block.settings.desktop_type }}" data-mobile-type="{{ block.settings.mobile_type }}" {{ block.shopify_attributes }}>
  <legend class="visually-hidden">{{ 'collection.grid_view' | t }}</legend>
  <span class="collection-columns__label body-text body-sm" aria-hidden="true">{{ 'collection.view' | t }}</span>
  {% for number in (1..2) %}
    <button class="collection-columns__option collection-columns__mobile" type="button" value="{{ number }}" aria-label="{{ number }} {{ 'collection.columns' | t }}" aria-pressed="false" data-collection-columns data-device="mobile" data-style="{{ block.settings.mobile_style | default: 'secondary' | replace: 'subtle', 'outline' | replace: 'tertiary', 'outline' }}">
      <span class="collection-columns__option-content">
        <span class="collection-columns__option-text" aria-hidden="true">{{ number }}</span>
        <span class="collection-columns__option-icon" style="--switcher-columns:{{ number }}" aria-hidden="true">{% for tile in (1..number) %}<i></i>{% endfor %}</span>
      </span>
    </button>
  {% endfor %}
  {% for number in (2..3) %}
    <button class="collection-columns__option collection-columns__tablet" type="button" value="{{ number }}" aria-label="{{ number }} {{ 'collection.columns' | t }}" aria-pressed="false" data-collection-columns data-device="tablet" data-style="{{ block.settings.desktop_style | default: 'primary' | replace: 'subtle', 'outline' | replace: 'tertiary', 'outline' }}">
      <span class="collection-columns__option-content">
        <span class="collection-columns__option-text" aria-hidden="true">{{ number }}</span>
        <span class="collection-columns__option-icon" style="--switcher-columns:{{ number }}" aria-hidden="true">{% for tile in (1..number) %}<i></i>{% endfor %}</span>
      </span>
    </button>
  {% endfor %}
  {% for number in (3..5) %}
    <button class="collection-columns__option collection-columns__desktop" type="button" value="{{ number }}" aria-label="{{ number }} {{ 'collection.columns' | t }}" aria-pressed="false" data-collection-columns data-device="desktop" data-style="{{ block.settings.desktop_style | default: 'primary' | replace: 'subtle', 'outline' | replace: 'tertiary', 'outline' }}">
      <span class="collection-columns__option-content">
        <span class="collection-columns__option-text" aria-hidden="true">{{ number }}</span>
        <span class="collection-columns__option-icon" style="--switcher-columns:{{ number }}" aria-hidden="true">{% for tile in (1..number) %}<i></i>{% endfor %}</span>
      </span>
    </button>
  {% endfor %}
</fieldset>
{% schema %}
{
  "name": "Column switcher",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Desktop" },
    { "type": "select", "id": "desktop_type", "label": "Type", "options": [
      { "value": "icon", "label": "Icon" }, { "value": "text", "label": "Text" }
    ], "default": "text" },
    { "type": "select", "id": "desktop_style", "label": "Desktop style", "options": [
      { "value": "primary", "label": "t:options.button_variant.primary" },
      { "value": "secondary", "label": "t:options.button_variant.secondary" },
      { "value": "outline", "label": "t:options.button_variant.outline" }
    ], "default": "primary" },
    { "type": "header", "content": "Mobile" },
    { "type": "select", "id": "mobile_type", "label": "Type", "options": [
      { "value": "icon", "label": "Icon" }, { "value": "text", "label": "Text" }
    ], "default": "icon" },
    { "type": "select", "id": "mobile_style", "label": "Mobile style", "options": [
      { "value": "primary", "label": "t:options.button_variant.primary" },
      { "value": "secondary", "label": "t:options.button_variant.secondary" },
      { "value": "outline", "label": "t:options.button_variant.outline" }
    ], "default": "secondary" }
  ]
}
{% endschema %}
