{% if block.settings.text != blank or request.design_mode %}
  <div class="faq-answer-text" {{ block.shopify_attributes }}>
    {% if block.settings.text != blank %}
      {{ block.settings.text }}
    {% else %}
      <p>Write the answer to this question here.</p>
    {% endif %}
  </div>
{% endif %}

{% render 'runtime-stylesheet', filename: 'component-runtime-blocks-faq_answer_text.css', section_index: section.index %}

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [
    {
      "name": "Text",
      "category": "Content"
    }
  ]
}
{% endschema %}
