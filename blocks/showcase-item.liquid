{% doc %}
  One centered Showcase carousel item. The parent controls card geometry and
  active state; Image and Group retain their shared editable content contracts.
{% enddoc %}
<div class="swiper-slide showcase-item" data-showcase-item data-block-id="{{ block.id }}" style="--showcase-image-spacing: {{ block.settings.image_spacing }}px; --showcase-image-spacing-mobile: {{ block.settings.image_spacing_mobile }}px;" {{ block.shopify_attributes }}>
  <div class="showcase-item__media">
    <div class="showcase-item__image">
      {% content_for 'block', type: 'image', id: 'image' %}
    </div>
  </div>
  <div class="showcase-item__content align-content" style="--showcase-content-padding-top: {{ block.settings.padding_top }}px; --showcase-content-padding-bottom: {{ block.settings.padding_bottom }}px; --showcase-content-padding-left: {{ block.settings.padding_left }}px; --showcase-content-padding-right: {{ block.settings.padding_right }}px;{% if block.settings.customize_mobile_padding %} --showcase-content-padding-top-mobile: {{ block.settings.padding_top_mobile }}px; --showcase-content-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px; --showcase-content-padding-left-mobile: {{ block.settings.padding_left_mobile }}px; --showcase-content-padding-right-mobile: {{ block.settings.padding_right_mobile }}px;{% endif %}">
    {% content_for 'block', type: 'group', id: 'content' %}
  </div>
</div>
{% schema %}
{
  "name": "Showcase item",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_spacing",
      "label": "Desktop image spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "image_spacing_mobile",
      "label": "Mobile image spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Showcase item",
      "blocks": [
        {
          "type": "image",
          "static": true,
          "settings": {
            "width_desktop": "fill",
            "width_mobile": "fill"
          },
          "id": "image"
        },
        {
          "type": "group",
          "static": true,
          "settings": {
            "alignment": "center",
            "alignment_mobile": "center",
            "gap_desktop": 12,
            "gap_mobile": 8
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "<p>Showcase your favorites</p>",
                "heading_size": "md",
                "html_tag": "h3"
              }
            },
            {
              "type": "text",
              "settings": {
                "text": "<p>Share what makes this collection special.</p>"
              }
            },
            {
              "type": "button",
              "settings": {
                "button_label": "Shop now",
                "button_link": "shopify://collections/all"
              }
            }
          ],
          "id": "content"
        }
      ]
    }
  ]
}
{% endschema %}
