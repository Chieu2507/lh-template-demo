{% doc %}
  Renders the fixed reveal carousel used by the Press section.

  The block owns carousel behavior, logo pagination and the spacing between the
  quote and logo rows. `press-item` owns its image settings and nested quote
  content. This block intentionally has no preset so it cannot be added as a
  second Quotes block. The reveal runtime is shared with the theme's existing
  carousel lifecycle.
{% enddoc %}

{% liquid
  assign press_quotes_autoplay = block.settings.autoplay
  if press_quotes_autoplay == nil
    assign press_quotes_autoplay = true
  endif

  assign press_quotes_pause_on_hover = block.settings.pause_on_hover
  if press_quotes_pause_on_hover == nil
    assign press_quotes_pause_on_hover = true
  endif

  assign press_quotes_speed = block.settings.autoplay_speed | default: 4 | plus: 0
  if press_quotes_speed < 3 or press_quotes_speed > 7
    assign press_quotes_speed = 4
  endif

  assign press_quotes_image_spacing_desktop = block.settings.image_spacing_desktop | default: 50 | plus: 0
  assign press_quotes_image_spacing_mobile = block.settings.image_spacing_mobile | default: 40 | plus: 0
  assign press_quotes_image_gap_desktop = block.settings.image_gap_desktop | default: 40 | plus: 0
  assign press_quotes_image_gap_mobile = block.settings.image_gap_mobile | default: 30 | plus: 0
  if press_quotes_image_spacing_desktop < 0 or press_quotes_image_spacing_desktop > 100
    assign press_quotes_image_spacing_desktop = 50
  endif
  if press_quotes_image_spacing_mobile < 0 or press_quotes_image_spacing_mobile > 100
    assign press_quotes_image_spacing_mobile = 40
  endif
  if press_quotes_image_gap_desktop < 0 or press_quotes_image_gap_desktop > 100
    assign press_quotes_image_gap_desktop = 40
  endif
  if press_quotes_image_gap_mobile < 0 or press_quotes_image_gap_mobile > 100
    assign press_quotes_image_gap_mobile = 30
  endif

  assign press_quotes_item_count = block.blocks.size | default: 0
  assign press_quotes_id = 'PressQuotes-' | append: block.id
  assign press_quotes_aria_label = 'press.carousel_label' | t
  assign press_quotes_delay = press_quotes_speed | times: 1000
  assign press_quotes_loop = false
  if press_quotes_item_count > 1
    assign press_quotes_loop = true
  endif
%}

<script data-theme-module="{{ 'carousel-block.js' | asset_url }}"></script>

{% capture press_quotes_items %}{% content_for 'blocks' %}{% endcapture %}

<div
  class="press-quotes reveal-carousel"
  style="--press-quotes-image-spacing: {{ press_quotes_image_spacing_desktop }}px; --press-quotes-image-spacing-mobile: {{ press_quotes_image_spacing_mobile }}px; --press-quotes-image-gap: {{ press_quotes_image_gap_desktop }}px; --press-quotes-image-gap-mobile: {{ press_quotes_image_gap_mobile }}px;"
  data-carousel-block
  data-carousel-mode="reveal"
  data-carousel-loop="{{ press_quotes_loop }}"
  data-swiper-autoplay="{{ press_quotes_autoplay }}"
  data-swiper-autoplay-pause-on-hover="{{ press_quotes_pause_on_hover }}"
  data-swiper-autoplay-delay="{{ press_quotes_delay }}"
  {{ block.shopify_attributes }}
>
  {% if press_quotes_item_count > 0 %}
    <div class="press-quotes__list reveal-carousel__list" id="{{ press_quotes_id }}" aria-label="{{ press_quotes_aria_label | escape }}">
      <div class="press-quotes__wrapper reveal-carousel__wrapper">
        {{ press_quotes_items }}
      </div>
    </div>
    <div class="press-quotes__pagination reveal-carousel__pagination scrollbar scrollbar--horizontal scrollbar--hidden" aria-label="{{ press_quotes_aria_label | escape }}">
      {% for press_item in block.blocks %}
        <button
          class="press-quotes__pagination-button reveal-carousel__pagination-button btn--unstyled"
          type="button"
          aria-current="{{ forloop.first }}"
          aria-label="{{ 'press.go_to_slide' | t: index: forloop.index | escape }}"
          aria-controls="{{ press_quotes_id }}"
          data-carousel-pagination-button
          data-carousel-pagination-index="{{ forloop.index0 }}"
          {{ press_item.shopify_attributes }}
        ></button>
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <div class="press-quotes__empty" role="status">{{ 'press.empty_quotes' | t }}</div>
  {% endif %}
</div>

{% render 'runtime-stylesheet', filename: 'component-runtime-blocks-press-quotes.css', section_index: section.index %}

{% schema %}
{
  "name": "t:general.quotes",
  "tag": null,
  "blocks": [{ "type": "press-item" }],
  "settings": [
    {
      "type": "header",
      "content": "t:labels.autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.auto_rotate_slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:labels.pause_on_hover",
      "default": true,
      "visible_if": "{{ block.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:labels.speed",
      "min": 3,
      "max": 7,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ block.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "t:general.image_spacing"
    },
    {
      "type": "range",
      "id": "image_spacing_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_spacing_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:general.image_gap"
    },
    {
      "type": "range",
      "id": "image_gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_gap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    }
  ]
}
{% endschema %}
