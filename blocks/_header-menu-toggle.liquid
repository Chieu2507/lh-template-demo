{% liquid
  assign menu_toggle_type = block.settings.type | default: 'icon'
  unless menu_toggle_type == 'icon' or menu_toggle_type == 'text' or menu_toggle_type == 'icon_with_text'
    assign menu_toggle_type = 'icon'
  endunless
  assign menu_toggle_label = block.settings.label
  if menu_toggle_label == blank
    assign menu_toggle_label = 'accessibility.menu' | t
  endif
%}

<button
  class="header-menu-toggle header-menu-toggle--type-{{ menu_toggle_type }} btn btn--unstyled body-text body-md font-accent tracking-normal text-case-original"
  type="button"
  aria-expanded="false"
  aria-controls="HeaderMobileDrawer-{{ section.id }}"
  aria-label="Open menu"
  data-header-menu-toggle
  {{ block.shopify_attributes }}
>
  {% unless menu_toggle_type == 'text' %}
  <span class="icon header-menu-toggle__open-icon" aria-hidden="true">
    {% render 'icon', icon: 'bars-3', bare: true %}
  </span>
  <span class="icon header-menu-toggle__close-icon" aria-hidden="true">
    {% render 'icon', icon: 'x-mark', bare: true %}
  </span>
  {% endunless %}
  {% unless menu_toggle_type == 'icon' %}
    <span class="header-action__label">{{ menu_toggle_label | escape }}</span>
  {% endunless %}
</button>

{% stylesheet %}
  .header-menu-toggle.btn {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: var(--button-height);
    min-width: var(--button-height);
    min-height: var(--button-height);
    color: var(--body-color);
  }

  .header-menu-toggle .icon {
    display: inline-flex;
    width: var(--header-icon-size, var(--icon-size-medium));
    height: var(--header-icon-size, var(--icon-size-medium));
    flex: 0 0 auto;
  }

  .header-menu-toggle .icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .header-menu-toggle__close-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__open-icon {
    display: none !important;
  }

  .header-top--menu-open .header-menu-toggle__close-icon {
    display: inline-flex !important;
  }

  @media (max-width: 991.98px) {
    .header-menu-toggle.btn {
      display: inline-flex;
      width: 24px;
      min-width: 24px;
      height: 24px;
      min-height: 24px;
    }
  }

  .header-menu-toggle.btn:not(.header-menu-toggle--type-icon) {
    width: auto;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header_menu_toggle",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "type",
      "label": "Type",
      "options": [
        { "value": "icon", "label": "Icon" },
        { "value": "text", "label": "Text" },
        { "value": "icon_with_text", "label": "Icon with text" }
      ],
      "default": "icon"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Menu",
      "visible_if": "{{ block.settings.type != 'icon' }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.header_menu_toggle",
      "category": "t:general.header"
    }
  ]
}
{% endschema %}
