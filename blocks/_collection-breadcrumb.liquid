{% doc %}Fixed collection breadcrumb, with resource title and configurable ancestor links.{% enddoc %}
<nav class="collection-banner__breadcrumb" aria-label="{{ 'breadcrumbs.navigation_label' | t }}" {{ block.shopify_attributes }}>
{% if block.settings.show_home_link %}<a href="{{ routes.root_url }}">{{ block.settings.home_label | escape }}</a><span aria-hidden="true">{{ block.settings.separator }}</span>{% endif %}
{% if block.settings.show_collections_link %}<a href="{{ routes.all_products_collection_url }}">{{ block.settings.collections_label | escape }}</a><span aria-hidden="true">{{ block.settings.separator }}</span>{% endif %}<span aria-current="page">{{ collection.title | escape }}</span></nav>
{% schema %}
{
  "name": "Breadcrumbs",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_home_link",
      "label": "Show home link",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "checkbox",
      "id": "show_collections_link",
      "label": "Show collections link",
      "default": true
    },
    {
      "type": "text",
      "id": "collections_label",
      "label": "Collections label",
      "default": "Shop"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator",
      "options": [
        {
          "value": "\u00b7",
          "label": "Dot"
        },
        {
          "value": "/",
          "label": "Slash"
        },
        {
          "value": "\u203a",
          "label": "Chevron"
        }
      ],
      "default": "\u00b7"
    }
  ]
}
{% endschema %}
