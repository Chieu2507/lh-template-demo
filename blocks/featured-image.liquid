{% doc %}
  Renders the featured image for the current article.
{% enddoc %}

{% if article.image %}
  <div class="article-featured-image article-featured-image--{{ block.settings.width | default: 'default' }} article-featured-image--height-{{ block.settings.height | default: 'adapt' }}" style="--article-image-padding-top: {{ block.settings.padding_top }}px; --article-image-padding-bottom: {{ block.settings.padding_bottom }}px; --article-image-padding-left: {{ block.settings.padding_left | default: 24 }}px; --article-image-padding-right: {{ block.settings.padding_right | default: 24 }}px; --article-image-padding-top-mobile: {{ block.settings.padding_top_mobile }}px; --article-image-padding-bottom-mobile: {{ block.settings.padding_bottom_mobile }}px;" {{ block.shopify_attributes }}>
    {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager' }}
  </div>
{% elsif request.design_mode %}
  <div class="article-featured-image__empty" {{ block.shopify_attributes }}>Add a featured image to this blog post.</div>
{% endif %}

{% render 'runtime-stylesheet', filename: 'component-runtime-blocks-featured-image.css', section_index: section.index %}

{% schema %}
{
  "name": "Featured image",
  "tag": null,
  "settings": [
    { "type": "select", "id": "width", "label": "Width", "options": [{ "value": "default", "label": "Default" }, { "value": "page", "label": "Page" }, { "value": "full", "label": "Full" }], "default": "default" },
    { "type": "select", "id": "height", "label": "Height", "options": [{ "value": "adapt", "label": "Adapt to image" }, { "value": "extra-small", "label": "Extra small" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }, { "value": "extra-large", "label": "Extra large" }], "default": "adapt" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "Left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24, "visible_if": "{{ block.settings.width == 'full' }}" },
    { "type": "range", "id": "padding_right", "label": "Right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24, "visible_if": "{{ block.settings.width == 'full' }}" },
    { "type": "checkbox", "id": "custom_mobile_padding", "label": "Customize for mobile", "default": false },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.custom_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ block.settings.custom_mobile_padding }}" }
  ]
}
{% endschema %}
