{% doc %}
  Renders native Shopify pagination for the blog article list.
{% enddoc %}

{% # theme-check-disable UndefinedObject %}
{% if paginate.pages > 1 %}
  <nav class="blog-pagination blog-pagination--{{ block.settings.style }} blog-pagination--height-{{ block.settings.height }}" aria-label="Pagination" style="--blog-pagination-padding-top: {{ block.settings.padding_top }}px; --blog-pagination-padding-bottom: {{ block.settings.padding_bottom }}px; --blog-pagination-padding-left: {{ block.settings.padding_left }}px; --blog-pagination-padding-right: {{ block.settings.padding_right }}px;" {{ block.shopify_attributes }}>
    {{ paginate | default_pagination }}
  </nav>
{% elsif request.design_mode %}
  <div class="blog-pagination blog-pagination--empty" {{ block.shopify_attributes }}>Pagination appears when this blog has more than one page.</div>
{% endif %}
{% # theme-check-enable UndefinedObject %}

{% render 'runtime-stylesheet', filename: 'component-runtime-blocks-pagination.css', section_index: section.index %}

{% schema %}
{
  "name": "Pagination",
  "tag": null,
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "outline", "label": "Outline" }, { "value": "text", "label": "Text" } ], "default": "primary" },
    { "type": "select", "id": "height", "label": "Height", "options": [ { "value": "inherit", "label": "Inherit" }, { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ], "default": "inherit" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "Left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "Right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "Pagination",
      "category": "Blog"
    }
  ]
}
{% endschema %}
