{% doc %}
  Shared Product callout presentation and hotspot controller, used by single
  callouts, carousel slides, and gallery image items. Each data-product-callout
  element owns its media bounds and open state; Shopify bundles this once.
{% enddoc %}

{% render 'component-stylesheet', filename: 'component-snippets-product-callout-runtime.css', section_index: section.index %}

{% javascript %}
  (() => {
    const instances = new WeakMap();

    const transitionDuration = (element) => {
      const style = getComputedStyle(element);
      const toMilliseconds = (value) => {
        const normalized = String(value || '').trim();
        const amount = Number.parseFloat(normalized);
        return Number.isFinite(amount) ? amount * (normalized.endsWith('ms') ? 1 : 1000) : 0;
      };
      const durations = String(style.transitionDuration || '0s').split(',').map(toMilliseconds);
      const delays = String(style.transitionDelay || '0s').split(',').map(toMilliseconds);

      return Math.max(0, ...durations.map((duration, index) => duration + (delays[index % delays.length] || 0)));
    };

    const parseCssLength = (value, fallback, element) => {
      const normalized = String(value || '').trim();
      const amount = Number.parseFloat(normalized);
      if (!Number.isFinite(amount)) return fallback;

      if (!normalized || normalized.endsWith('px')) return amount;
      if (normalized.endsWith('vw')) return (window.innerWidth * amount) / 100;
      if (normalized.endsWith('vh')) return (window.innerHeight * amount) / 100;

      const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      if (normalized.endsWith('rem')) return rootFontSize * amount;
      if (normalized.endsWith('em')) {
        const fontSize = Number.parseFloat(getComputedStyle(element || document.documentElement).fontSize) || rootFontSize;
        return fontSize * amount;
      }

      return fallback;
    };

    const clamp = (value, minimum, maximum) => {
      if (maximum < minimum) return minimum;
      return Math.min(Math.max(value, minimum), maximum);
    };

    const getPopoverBounds = (state, popover) => {
      const media = state.callout.querySelector('.product-callout__media') || state.callout;
      const mediaRect = media.getBoundingClientRect();
      const style = getComputedStyle(popover);
      const margin = Math.max(0, parseCssLength(style.getPropertyValue('--product-callout-popover-viewport-margin'), 16, popover));
      const viewport = {
        // The horizontal edge belongs to the media, not the page margin. A
        // hotspot at either edge should let its card meet that edge instead
        // of leaving a second, unrelated gutter inside the media.
        left: 0,
        top: margin,
        right: window.innerWidth,
        bottom: Math.max(margin, window.innerHeight - margin),
      };

      const bounds = {
        left: Math.max(viewport.left, mediaRect.left),
        top: Math.max(viewport.top, mediaRect.top),
        right: Math.min(viewport.right, mediaRect.right),
        bottom: Math.min(viewport.bottom, mediaRect.bottom),
      };

      if (bounds.right <= bounds.left || bounds.bottom <= bounds.top) return viewport;
      return bounds;
    };

    const setAnchorProperties = (popover, triggerRect) => {
      const properties = {
        '--product-callout-popover-anchor-top': `${triggerRect.top}px`,
        '--product-callout-popover-anchor-right': `${Math.max(0, window.innerWidth - triggerRect.right)}px`,
        '--product-callout-popover-anchor-bottom': `${Math.max(0, window.innerHeight - triggerRect.bottom)}px`,
        '--product-callout-popover-anchor-left': `${triggerRect.left}px`,
        '--product-callout-popover-anchor-width': `${triggerRect.width}px`,
        '--product-callout-popover-anchor-height': `${triggerRect.height}px`,
      };

      Object.entries(properties).forEach(([property, value]) => popover.style.setProperty(property, value));
    };

    const clearPopoverPosition = (popover) => {
      [
        'inset',
        'inset-block-start',
        'inset-block-end',
        'inset-inline-start',
        'inset-inline-end',
        'top',
        'right',
        'bottom',
        'left',
        'inline-size',
        'min-inline-size',
        'max-inline-size',
        'transform',
      ].forEach((property) => popover.style.removeProperty(property));

      [
        '--product-callout-popover-anchor-top',
        '--product-callout-popover-anchor-right',
        '--product-callout-popover-anchor-bottom',
        '--product-callout-popover-anchor-left',
        '--product-callout-popover-anchor-width',
        '--product-callout-popover-anchor-height',
      ].forEach((property) => popover.style.removeProperty(property));
    };

    const getVerticalCandidate = (vertical, triggerRect, width, height, gap) => ({
      left: triggerRect.left + (triggerRect.width - width) / 2,
      top: vertical === 'top' ? triggerRect.top - gap - height : triggerRect.bottom + gap,
    });

    const getOverflow = (candidate, width, height, bounds) => {
      return (
        Math.max(0, bounds.left - candidate.left) +
        Math.max(0, candidate.left + width - bounds.right) +
        Math.max(0, bounds.top - candidate.top) +
        Math.max(0, candidate.top + height - bounds.bottom)
      );
    };

    const positionPopover = (state, record) => {
      const { wrapper, trigger, popover } = record;
      if (!wrapper.isConnected || !trigger.isConnected || !popover.isConnected) return;

      const bounds = getPopoverBounds(state, popover);
      const triggerRect = trigger.getBoundingClientRect();
      const wrapperRect = wrapper.getBoundingClientRect();
      const style = getComputedStyle(popover);
      const gap = Math.max(0, parseCssLength(style.getPropertyValue('--product-callout-popover-gap'), 8, popover));

      setAnchorProperties(popover, triggerRect);
      popover.style.removeProperty('inline-size');

      let width = popover.offsetWidth;
      if (width > bounds.right - bounds.left) {
        popover.style.inlineSize = `${Math.max(1, bounds.right - bounds.left)}px`;
        width = popover.offsetWidth;
      }

      const height = popover.offsetHeight;
      const preferredVertical = popover.classList.contains('product-callout__popover--top') ? 'top' : 'bottom';
      const oppositeVertical = preferredVertical === 'top' ? 'bottom' : 'top';

      const candidates = [preferredVertical, oppositeVertical].map((vertical) => getVerticalCandidate(vertical, triggerRect, width, height, gap));
      if (state.callout.dataset.productCalloutPopoverPlacement === 'side' && window.matchMedia('(min-width: 768px)').matches) {
        candidates.unshift(
          { left: triggerRect.right + gap, top: triggerRect.top + (triggerRect.height - height) / 2 },
          { left: triggerRect.left - gap - width, top: triggerRect.top + (triggerRect.height - height) / 2 },
        );
      }
      let candidate = candidates.find((item) => getOverflow(item, width, height, bounds) === 0);
      if (!candidate) {
        candidate = candidates.reduce((best, item) => {
          if (!best) return item;
          return getOverflow(item, width, height, bounds) < getOverflow(best, width, height, bounds) ? item : best;
        }, null);
      }

      candidate.left = clamp(candidate.left, bounds.left, bounds.right - width);

      candidate.top = clamp(candidate.top, bounds.top, bounds.bottom - height);

      popover.style.setProperty('inset', 'auto');
      popover.style.setProperty('left', `${candidate.left - wrapperRect.left}px`);
      popover.style.setProperty('top', `${candidate.top - wrapperRect.top}px`);
      popover.style.setProperty('right', 'auto');
      popover.style.setProperty('bottom', 'auto');
      popover.style.setProperty('transform', 'none');
    };

    const cancelPopoverClose = (state, popover) => {
      const closing = state.closing.get(popover);
      if (!closing) return;

      clearTimeout(closing.timer);
      state.closing.delete(popover);
      closing.record.wrapper.classList.remove('product-callout__hotspot-wrap--closing');
      popover.hidden = false;
      popover.inert = false;
      popover.removeAttribute('aria-hidden');
      popover.removeAttribute('inert');
    };

    const closeActive = (state, restoreFocus = false, immediate = false) => {
      const active = state.active;
      if (!active) return;

      active.popover.classList.remove('product-callout__popover--visible');
      active.popover.inert = true;
      active.popover.setAttribute('aria-hidden', 'true');
      active.popover.setAttribute('inert', '');
      active.wrapper.classList.remove('product-callout__hotspot-wrap--active');
      active.trigger.setAttribute('aria-expanded', 'false');
      state.active = null;

      const finishClose = () => {
        const closing = state.closing.get(active.popover);
        if (closing?.record !== active) return;

        clearTimeout(closing.timer);
        state.closing.delete(active.popover);
        active.popover.hidden = true;
        clearPopoverPosition(active.popover);
        active.wrapper.classList.remove('product-callout__hotspot-wrap--closing');
      };

      if (immediate) {
        active.popover.hidden = true;
        clearPopoverPosition(active.popover);
        active.wrapper.classList.remove('product-callout__hotspot-wrap--closing');
      } else {
        active.wrapper.classList.add('product-callout__hotspot-wrap--closing');
        const duration = transitionDuration(active.popover);
        if (duration === 0) {
          active.popover.hidden = true;
          clearPopoverPosition(active.popover);
          active.wrapper.classList.remove('product-callout__hotspot-wrap--closing');
        } else {
          const closing = { record: active, timer: null };
          closing.timer = window.setTimeout(finishClose, duration + 20);
          state.closing.set(active.popover, closing);
        }
      }

      if (restoreFocus) active.trigger.focus({ preventScroll: true });
    };

    const openPopover = (state, trigger) => {
      const wrapper = trigger.closest('[data-product-callout-hotspot-wrap]');
      const popover = wrapper?.querySelector('[data-product-callout-popover]');
      if (!wrapper || !popover) return;

      const isActive = state.active?.trigger === trigger;
      if (isActive) {
        if (state.toggleOnClick) closeActive(state);
        return;
      }

      closeActive(state);
      cancelPopoverClose(state, popover);
      clearPopoverPosition(popover);

      popover.hidden = false;
      popover.inert = false;
      popover.removeAttribute('aria-hidden');
      popover.removeAttribute('inert');
      popover.classList.remove('product-callout__popover--visible');
      wrapper.classList.add('product-callout__hotspot-wrap--active');
      trigger.setAttribute('aria-expanded', 'true');
      state.active = { trigger, wrapper, popover };
      positionPopover(state, state.active);

      // Establish the hidden visual state before transitioning to open. This
      // keeps click and hover entrances consistent despite the native hidden attribute.
      void popover.offsetWidth;
      window.requestAnimationFrame(() => {
        if (state.active?.popover === popover && popover.isConnected) {
          popover.classList.add('product-callout__popover--visible');
        }
      });
    };

    const initialize = (callout) => {
      if (!callout || instances.has(callout)) return;

      const controller = new AbortController();
      const state = {
        callout,
        controller,
        active: null,
        closing: new Map(),
        positionFrame: null,
        resizeObserver: null,
        hotspotBehavior: callout.closest('[data-product-callout-hotspot-behavior]')?.dataset.productCalloutHotspotBehavior === 'hover' ? 'hover' : 'click',
        toggleOnClick: true,
      };
      instances.set(callout, state);

      const schedulePosition = () => {
        if (!state.active || state.positionFrame !== null) return;

        state.positionFrame = window.requestAnimationFrame(() => {
          state.positionFrame = null;
          if (state.active) positionPopover(state, state.active);
        });
      };

      window.addEventListener('resize', schedulePosition, { signal: controller.signal });

      const closeForScroll = () => {
        if (state.active) closeActive(state, false, true);
      };

      window.addEventListener('scroll', closeForScroll, { passive: true, signal: controller.signal });
      document.addEventListener('scroll', closeForScroll, { capture: true, passive: true, signal: controller.signal });

      if (typeof window.ResizeObserver === 'function') {
        state.resizeObserver = new window.ResizeObserver(schedulePosition);
        state.resizeObserver.observe(callout);
        callout.querySelectorAll('[data-product-callout-popover]').forEach((popover) => state.resizeObserver.observe(popover));
      }

      const openForHover = (event) => {
        if (state.hotspotBehavior !== 'hover' || event.pointerType === 'touch') return;
        const trigger = event.currentTarget.querySelector('[data-product-callout-hotspot]');
        if (!trigger) return;

        state.toggleOnClick = false;
        openPopover(state, trigger);
        state.toggleOnClick = true;
      };

      const closeForHover = (event) => {
        if (state.hotspotBehavior !== 'hover') return;
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && callout.contains(nextTarget)) return;
        closeActive(state);
      };

      const openForFocus = (event) => {
        if (state.hotspotBehavior !== 'hover' || event.target !== event.currentTarget.querySelector('[data-product-callout-hotspot]')) return;

        state.toggleOnClick = false;
        openPopover(state, event.target);
        state.toggleOnClick = true;
      };

      const closeForFocus = (event) => {
        if (state.hotspotBehavior !== 'hover') return;
        const nextTarget = event.relatedTarget;
        if (nextTarget instanceof Node && event.currentTarget.contains(nextTarget)) return;
        if (state.active?.wrapper === event.currentTarget) closeActive(state);
      };

      callout.querySelectorAll('[data-product-callout-hotspot-wrap]').forEach((wrapper) => {
        wrapper.addEventListener('pointerenter', openForHover, { signal: controller.signal });
        wrapper.addEventListener('focusin', openForFocus, { signal: controller.signal });
        wrapper.addEventListener('focusout', closeForFocus, { signal: controller.signal });
      });

      callout.addEventListener('pointerleave', closeForHover, { signal: controller.signal });

      if (callout.hasAttribute('data-hotspot-gallery-item')) {
        callout.addEventListener('shopify:block:select', () => {
          const trigger = callout.querySelector('[data-product-callout-hotspot]');
          if (!trigger) return;
          state.toggleOnClick = false;
          openPopover(state, trigger);
          state.toggleOnClick = true;
        }, { signal: controller.signal });
        callout.addEventListener('shopify:block:deselect', () => closeActive(state, false, true), { signal: controller.signal });
      }

      callout.addEventListener(
        'click',
        (event) => {
          const trigger = event.target.closest?.('[data-product-callout-hotspot]');
          if (!trigger || !callout.contains(trigger)) {
            const clickedPopover = event.target instanceof Node && state.active?.popover.contains(event.target);
            if (!clickedPopover) closeActive(state);
            return;
          }
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          event.preventDefault();
          state.toggleOnClick = true;
          openPopover(state, trigger);
        },
        { signal: controller.signal },
      );

      document.addEventListener(
        'click',
        (event) => {
          if (state.active && !callout.contains(event.target)) closeActive(state);
        },
        { signal: controller.signal },
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'Escape' || !state.active) return;
          event.preventDefault();
          closeActive(state, true);
        },
        { signal: controller.signal },
      );

      document.addEventListener(
        'theme:carousel:slidechange',
        (event) => {
          const carouselRoot = event.detail?.root;
          if (!carouselRoot?.contains?.(callout)) return;
          closeActive(state, false, true);
        },
        { signal: controller.signal },
      );
    };

    const destroy = (callout) => {
      const state = instances.get(callout);
      if (!state) return;
      if (state.positionFrame !== null) window.cancelAnimationFrame(state.positionFrame);
      state.positionFrame = null;
      state.resizeObserver?.disconnect();
      closeActive(state, false, true);
      state.closing.forEach((closing, popover) => {
        clearTimeout(closing.timer);
        popover.hidden = true;
        clearPopoverPosition(popover);
        popover.classList.remove('product-callout__popover--visible');
        closing.record.wrapper.classList.remove('product-callout__hotspot-wrap--closing');
      });
      state.closing.clear();
      callout.querySelectorAll('[data-product-callout-popover]').forEach(clearPopoverPosition);
      state.controller.abort();
      instances.delete(callout);
    };

    const initializeRoot = (root = document) => {
      if (root.matches?.('[data-product-callout]')) initialize(root);
      root.querySelectorAll?.('[data-product-callout]').forEach(initialize);
    };

    const destroyRoot = (root) => {
      if (root.matches?.('[data-product-callout]')) destroy(root);
      root.querySelectorAll?.('[data-product-callout]').forEach(destroy);
    };

    document.addEventListener('shopify:section:load', (event) => initializeRoot(event.target));
    document.addEventListener('shopify:section:unload', (event) => destroyRoot(event.target));

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeRoot(), { once: true });
    } else {
      initializeRoot();
    }
  })();
{% endjavascript %}
