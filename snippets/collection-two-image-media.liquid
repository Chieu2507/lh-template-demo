{% doc %}
  Renders a decorative image in a paired collection presentation.
  @param {image} [image] - Selected collection image
  @param {string} position - Primary or secondary slot
{% enddoc %}
<figure class="collection-two-image__image collection-two-image__image--{{ position }}{% if image == blank %} placeholder-image{% endif %}" aria-hidden="true">
  {% if image != blank %}
    {{ image | image_url: width: 1200 | image_tag: widths: '128, 252, 504, 640, 896, 1120, 1200', sizes: '(max-width: 767px) 252px, (max-width: 1149px) 64px, 30vw', alt: '', loading: 'lazy' }}
  {% else %}
    {{ 'collection-1' | placeholder_svg_tag }}
  {% endif %}
</figure>
