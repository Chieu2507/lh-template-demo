{% doc %}
  Renders the shared product badge primitive.

  The data layer chooses the label and semantic tone. Manual New and Best
  Sellers labels use their configured theme colors; other labels retain the
  generic manual appearance.

  @param {string} text - Badge label
  @param {string} [tone] - sale, sold-out, new, best-seller or manual

  @example
  {% render 'badge', text: 'Sale', tone: 'sale' %}
{% enddoc %}

{% liquid
  assign badge_tone = tone | default: 'sale'
  if badge_tone == 'manual'
    assign normalized_label = text | strip | downcase | remove: '!'
    case normalized_label
      when 'new'
        assign badge_tone = 'new'
      when 'best seller', 'best sellers'
        assign badge_tone = 'best-seller'
    endcase
  endif
  unless badge_tone == 'new' or badge_tone == 'best-seller' or badge_tone == 'sale' or badge_tone == 'sold-out' or badge_tone == 'manual'
    assign badge_tone = 'sale'
  endunless
  assign badge_class = 'product-badge product-badge--' | append: badge_tone
%}

<span class="{{ badge_class | strip }}">
  {{ text | escape }}
</span>
