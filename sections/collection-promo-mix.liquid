{% liquid
  assign container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign container_width = 'full-width'
  endif
  assign scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1'
  assign top_mobile = section.settings.padding_top
  assign bottom_mobile = section.settings.padding_bottom
  if section.settings.customize_mobile_padding
    assign top_mobile = section.settings.padding_top_mobile
    assign bottom_mobile = section.settings.padding_bottom_mobile
  endif
%}
{% style %}#shopify-section-{{ section.id }} { background: {{ section.settings.background_color | default: section.settings.color_scheme.settings.background }}; }{% endstyle %}
<div class="section-spacing collection-promo-mix color-scheme section-color-scope {{ scheme | handleize }}" style="--mix-columns:{{ section.settings.columns_desktop }};--mix-columns-tablet:{{ section.settings.columns_tablet }};--mix-columns-mobile:{{ section.settings.columns_mobile }};--mix-gap:{{ section.settings.gap_desktop }}px;--mix-gap-mobile:{{ section.settings.gap_mobile }}px;--mix-top:{{ section.settings.padding_top }}px;--mix-bottom:{{ section.settings.padding_bottom }}px;--mix-top-mobile:{{ top_mobile }}px;--mix-bottom-mobile:{{ bottom_mobile }}px;{% if section.settings.background_color != blank %}--mix-background:{{ section.settings.background_color | escape }};{% endif %}">
  <div class="container {{ container_width }}"><div class="collection-promo-mix__grid">{% content_for 'blocks' %}</div></div>
</div>
{% stylesheet %}
.collection-promo-mix{padding-block:var(--mix-top,0px) var(--mix-bottom,0px);background:var(--mix-background,var(--background-color));}
.collection-promo-mix__grid{display:grid;grid-template-columns:repeat(var(--mix-columns,3),minmax(0,1fr));gap:var(--mix-gap,32px);align-items:stretch;}
.collection-promo-mix__grid>*{min-width:0;max-width:100%;}
@media(min-width:768px) and (max-width:1149.98px){.collection-promo-mix__grid{grid-template-columns:repeat(var(--mix-columns-tablet,1),minmax(0,1fr));}}
@media(max-width:767.98px){.collection-promo-mix{padding-block:var(--mix-top-mobile,var(--mix-top)) var(--mix-bottom-mobile,var(--mix-bottom));}.collection-promo-mix__grid{grid-template-columns:repeat(var(--mix-columns-mobile,1),minmax(0,1fr));gap:var(--mix-gap-mobile,var(--mix-gap));}.collection-promo-mix__grid>*{order:var(--group-order-mobile,var(--promo-panel-order-mobile,0));}}
{% endstylesheet %}
{% schema %}
{
  "name": "Collection promo mix",
  "class": "section-collection-promo-mix",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "collection-promo-grid"
    },
    {
      "type": "group"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "default": "page_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "default": "3",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Collection promo mix",
      "blocks": [
        {
          "type": "collection-promo-grid"
        },
        {
          "type": "group",
          "blocks": [
            {
              "type": "image-card"
            }
          ]
        },
        {
          "type": "collection-promo-grid",
          "settings": {
            "tall_side": "right"
          }
        }
      ]
    }
  ]
}
{% endschema %}
