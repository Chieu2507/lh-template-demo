{% liquid
  assign section_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_width = 'full-width'
  endif
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign boxed_scheme = section.settings.boxed_color_scheme | default: scheme
  assign collection_items = section.blocks | where: 'type', 'collections-with-tabs-item'
  assign item_count = collection_items.size | at_least: 1
  assign initial_image = collection_items.first.settings.custom_image | default: collection_items.first.settings.collection.featured_image
  assign initial_ratio = section.settings.image_ratio
  if initial_ratio == 'auto' or initial_ratio == blank
    assign initial_ratio = initial_image.aspect_ratio | default: 1
  endif
%}
<script type="module" src="{{ 'collections-with-tabs.js' | asset_url }}"></script>
<div class="section-spacing collections-with-tabs color-scheme section-color-scope {{ scheme }}{% if section.settings.boxed_layout %} collections-with-tabs--boxed{% endif %}" style="--collections-with-tabs-gap:{{ section.settings.gap_desktop | default: 90 }}px;--collections-with-tabs-gap-mobile:{{ section.settings.gap_mobile | default: 30 }}px;--collections-with-tabs-padding-top:{{ section.settings.padding_top | default: 50 }}px;--collections-with-tabs-padding-bottom:{{ section.settings.padding_bottom | default: 50 }}px;--collections-with-tabs-boxed-y:{{ section.settings.boxed_padding_vertical | default: 70 }}px;--collections-with-tabs-boxed-x:{{ section.settings.boxed_padding_horizontal | default: 70 }}px;--collections-with-tabs-boxed-y-mobile:{{ section.settings.boxed_padding_vertical_mobile | default: 50 }}px;--collections-with-tabs-boxed-x-mobile:{{ section.settings.boxed_padding_horizontal_mobile | default: 20 }}px;{% if section.settings.customize_mobile_padding %}--collections-with-tabs-padding-top-mobile:{{ section.settings.padding_top_mobile | default: 50 }}px;--collections-with-tabs-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile | default: 50 }}px;{% endif %}--collections-with-tabs-row-count:{{ item_count }};--collections-with-tabs-image-ratio:{{ initial_ratio }};{% if section.settings.inactive_title_color != blank %}--collections-with-tabs-inactive-color:{{ section.settings.inactive_title_color }};{% endif %}--collections-with-tabs-progress-duration:{{ section.settings.auto_rotate_speed | default: 6 }}s;" data-collections-with-tabs data-auto-rotate="{{ section.settings.auto_rotate }}" data-auto-rotate-speed="{{ section.settings.auto_rotate_speed | default: 6 }}">
  {% if section.settings.background_media != 'none' %}
    <div class="collections-with-tabs__background" aria-hidden="true">
      {% if section.settings.background_media == 'image' and section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      {% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}
        {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x' }}
      {% else %}
        <div class="collections-with-tabs__background-placeholder placeholder-image">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  {% endif %}
  <div class="container {{ section_width }}">
    <div class="collections-with-tabs__box{% if section.settings.boxed_layout %} color-scheme section-color-scope {{ boxed_scheme }}{% endif %}">
      {% capture collection_header %}{% content_for 'block', type: 'header', id: 'look-header' %}{% endcapture %}
      {% assign collection_header = collection_header | strip %}
      {% if collection_header != blank %}<div class="collections-with-tabs__header align-content">{{ collection_header }}</div>{% endif %}
      <div class="collections-with-tabs__body collections-with-tabs__body--{{ section.settings.image_position | default: 'right' }}">
        <div class="collections-with-tabs__navigation" role="tablist" aria-orientation="vertical" aria-label="Collections">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
.collections-with-tabs{position:relative;isolation:isolate;overflow:hidden;padding-block:var(--collections-with-tabs-padding-top) var(--collections-with-tabs-padding-bottom);background:var(--background-color)}
.collections-with-tabs__background{position:absolute;z-index:-1;inset:0}
.collections-with-tabs__background :is(img,video,.collections-with-tabs__background-placeholder){display:block;width:100%;height:100%;object-fit:cover}
.collections-with-tabs__background-placeholder svg{width:100%;height:100%;fill:var(--placeholder-fill-color)}
.collections-with-tabs>.container{position:relative}
.collections-with-tabs__box{display:grid;gap:var(--collections-with-tabs-gap-mobile)}
.collections-with-tabs__item{display:contents}
.collections-with-tabs--boxed .collections-with-tabs__box{padding:var(--collections-with-tabs-boxed-y) var(--collections-with-tabs-boxed-x)}
.collections-with-tabs__body{min-width:0;container-type:inline-size}
.collections-with-tabs__navigation{display:grid;grid-template-columns:minmax(16rem,1fr) minmax(0,1fr);column-gap:var(--collections-with-tabs-gap);grid-template-rows:repeat(var(--collections-with-tabs-row-count),max-content);align-content:center;position:relative;min-height:calc((100cqw - var(--collections-with-tabs-gap)) / 2 / var(--collections-with-tabs-image-ratio,1))}
.collections-with-tabs__header{grid-column:1 / -1;--flex-align:center;--flex-align-mobile:center}
.collections-with-tabs__tab-row{position:relative;grid-column:1;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center}
.collections-with-tabs__tab{position:relative;grid-column:1 / -1;grid-row:1;display:flex;align-items:center;gap:1rem;width:100%;min-height:5.3rem;padding:4rem 6rem 4rem 0;border:0;border-bottom:1px solid var(--border-color);background:transparent;color:var(--collections-with-tabs-inactive-color,color-mix(in srgb,var(--heading-color) 45%,var(--background-color)));cursor:pointer;text-align:left}
.collections-with-tabs__tab[aria-selected='true']{color:var(--heading-color)}
.collections-with-tabs__item:first-child .collections-with-tabs__tab{border-top:1px solid var(--border-color)}
.collections-with-tabs__tab-content{display:inline-flex;align-items:flex-start;gap:.25rem;min-width:0}
.collections-with-tabs__tab-title.heading-custom{font-size:var(--heading-block-custom-size,var(--font-heading-custom))}
.collections-with-tabs__tab-title{margin:0;color:inherit;overflow-wrap:anywhere}
.collections-with-tabs__tab-count{margin-top:.2em;font-family:var(--font-body-family);font-size:.75rem;line-height:1}
.collections-with-tabs__tab-action{--button-height:48px;grid-column:2;grid-row:1;z-index:1;display:inline-flex;flex:0 0 48px;width:48px;min-width:48px;height:48px;min-height:48px;border-radius:50%;font-family:Arial,sans-serif;font-size:1rem;font-style:normal;font-weight:400;line-height:1;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .25s ease,transform var(--button-motion-duration,var(--motion-duration-standard)) var(--button-motion-ease,var(--motion-ease-standard))}
.collections-with-tabs__tab[aria-selected='true'] + .collections-with-tabs__tab-action{opacity:1;visibility:visible;pointer-events:auto}
.collections-with-tabs__tab-action svg{width:20px;height:20px}
.collections-with-tabs__tab:focus-visible{outline:2px solid currentColor;outline-offset:3px}
.collections-with-tabs__tab[aria-selected='true']::after{position:absolute;right:0;bottom:-1px;left:0;height:2px;content:"";background:var(--heading-color);transform:scaleX(var(--collections-with-tabs-progress-scale,0));transform-origin:left center}
.collections-with-tabs__panel{position:absolute;grid-column:2;grid-row:1 / -1;top:50%;width:100%;min-width:0;align-self:start;pointer-events:none;opacity:0;visibility:hidden;transform:translateY(-50%) scale(1.035);transform-origin:center;transition:opacity .4s ease,transform .55s var(--motion-ease-standard,ease),visibility 0s linear .55s}.collections-with-tabs__panel[hidden]{display:none}.collections-with-tabs__panel[data-active='true']{z-index:1;pointer-events:auto;opacity:1;visibility:visible;transform:translateY(-50%) scale(1);transition-delay:0s}
.collections-with-tabs__media{background:var(--placeholder-background-color);aspect-ratio:var(--collections-with-tabs-panel-ratio,1 / 1)}
.collections-with-tabs__media--custom .placeholder-image{--placeholder-background-color:var(--collections-with-tabs-custom-background)}
.collections-with-tabs__media .media__inner>img{object-fit:cover}.collections-with-tabs__media svg.collections-with-tabs__placeholder{fill:var(--placeholder-fill-color)}
.collections-with-tabs__featured{position:absolute;z-index:1;top:1rem;right:1rem;display:flex;align-items:center;gap:.25rem;opacity:0;transform:translateX(1.5rem);transition:opacity .35s ease,transform .35s ease}.collections-with-tabs__panel[data-active='true'] .collections-with-tabs__featured{opacity:1;transform:none}
.collections-with-tabs__featured-more{display:grid;place-items:center;width:40px;height:40px;color:#fff;background:rgb(0 0 0 / .18);font-size:1.25rem}.collections-with-tabs__featured-product{display:block;width:40px;height:40px;overflow:hidden;background:var(--placeholder-background-color)}.collections-with-tabs__featured-product img{display:block;width:100%;height:100%;object-fit:cover}
.collections-with-tabs__body--left .collections-with-tabs__header,.collections-with-tabs__body--left .collections-with-tabs__tab-row{grid-column:2}.collections-with-tabs__body--left .collections-with-tabs__panel{grid-column:1}
@media(max-width:767.98px){.collections-with-tabs{padding-block:var(--collections-with-tabs-padding-top-mobile,var(--collections-with-tabs-padding-top)) var(--collections-with-tabs-padding-bottom-mobile,var(--collections-with-tabs-padding-bottom))}.collections-with-tabs--boxed .collections-with-tabs__box{padding:var(--collections-with-tabs-boxed-y-mobile) var(--collections-with-tabs-boxed-x-mobile)}.collections-with-tabs__box{gap:var(--collections-with-tabs-gap-mobile)}.collections-with-tabs__navigation{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:none;min-height:0;column-gap:0}.collections-with-tabs__header,.collections-with-tabs__body--left .collections-with-tabs__header{grid-column:1;grid-row:1;width:100%}.collections-with-tabs__panel,.collections-with-tabs__body--left .collections-with-tabs__panel{position:relative;top:auto;grid-column:1;grid-row:1;width:100%;margin:0 0 var(--collections-with-tabs-gap-mobile);transform:none}.collections-with-tabs__panel[data-active='true']{transform:none}.collections-with-tabs__tab-row,.collections-with-tabs__body--left .collections-with-tabs__tab-row{grid-column:1;grid-row:auto;width:100%}.collections-with-tabs__tab{min-height:4rem;padding-block:1.5rem}}
@media(prefers-reduced-motion:reduce){.collections-with-tabs__tab-action,.collections-with-tabs__featured,.collections-with-tabs__panel{transition:none}}
{% endstylesheet %}
{% schema %}
{
  "name": "Collections with tabs",
  "class": "section-collections-with-tabs",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "header"
    },
    {
      "type": "collections-with-tabs-item"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page_width",
          "label": "Page"
        },
        {
          "value": "full_width",
          "label": "Full"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "checkbox",
      "id": "boxed_layout",
      "label": "Enable boxed layout",
      "default": true
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Collection image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "auto",
          "label": "Adapt to first image"
        },
        {
          "value": "1",
          "label": "Square (1:1)"
        },
        {
          "value": "0.8",
          "label": "Portrait (4:5)"
        },
        {
          "value": "0.75",
          "label": "Portrait (3:4)"
        },
        {
          "value": "0.6667",
          "label": "Portrait (2:3)"
        },
        {
          "value": "1.5",
          "label": "Landscape (3:2)"
        },
        {
          "value": "1.3333",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "show_featured_products",
      "label": "Show featured products",
      "default": true
    },
    {
      "type": "select",
      "id": "products_to_show",
      "label": "Number of products",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.show_featured_products }}"
    },
    {
      "type": "header",
      "content": "Collection title"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "t:labels.heading_size",
      "options": [
        {
          "value": "display",
          "label": "t:options.heading_size.display"
        },
        {
          "value": "xl",
          "label": "t:options.heading_size.xl"
        },
        {
          "value": "lg",
          "label": "t:options.heading_size.lg"
        },
        {
          "value": "md",
          "label": "t:options.heading_size.md"
        },
        {
          "value": "sm",
          "label": "t:options.heading_size.sm"
        },
        {
          "value": "xs",
          "label": "t:options.heading_size.xs"
        },
        {
          "value": "custom",
          "label": "t:options.heading_size.custom"
        }
      ],
      "default": "xl"
    },
    {
      "type": "range",
      "id": "custom_heading_size",
      "label": "Custom size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.title_size == 'custom' }}"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "t:labels.html_tag",
      "info": "t:info.heading_html_tag",
      "options": [
        {
          "value": "div",
          "label": "t:options.html_tag.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.html_tag.h1"
        },
        {
          "value": "h2",
          "label": "t:options.html_tag.h2"
        },
        {
          "value": "h3",
          "label": "t:options.html_tag.h3"
        },
        {
          "value": "h4",
          "label": "t:options.html_tag.h4"
        },
        {
          "value": "h5",
          "label": "t:options.html_tag.h5"
        },
        {
          "value": "h6",
          "label": "t:options.html_tag.h6"
        }
      ],
      "default": "div"
    },
    {
      "type": "color",
      "id": "inactive_title_color",
      "label": "Inactive title color"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate tabs",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_rotate_speed",
      "label": "Speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.auto_rotate }}"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:general.media",
      "options": [
        {
          "value": "none",
          "label": "t:options.background_media.none"
        },
        {
          "value": "image",
          "label": "t:general.image"
        },
        {
          "value": "video",
          "label": "t:general.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "boxed_color_scheme",
      "label": "Boxed color scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.boxed_layout }}"
    },
    {
      "type": "header",
      "content": "Boxed padding"
    },
    {
      "type": "range",
      "id": "boxed_padding_vertical",
      "label": "Top and bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 70,
      "visible_if": "{{ section.settings.boxed_layout }}"
    },
    {
      "type": "range",
      "id": "boxed_padding_horizontal",
      "label": "Left and right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 70,
      "visible_if": "{{ section.settings.boxed_layout }}"
    },
    {
      "type": "range",
      "id": "boxed_padding_vertical_mobile",
      "label": "Top and bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.boxed_layout }}"
    },
    {
      "type": "range",
      "id": "boxed_padding_horizontal_mobile",
      "label": "Left and right (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.boxed_layout }}"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Collections with tabs",
      "category": "Collections",
      "settings": {
        "boxed_layout": true,
        "gap_desktop": 90,
        "gap_mobile": 30,
        "image_position": "right",
        "image_ratio": "auto",
        "show_featured_products": true,
        "products_to_show": "2",
        "show_product_count": true,
        "auto_rotate": true,
        "auto_rotate_speed": 6
      },
      "blocks": [
        {
          "type": "header",
          "id": "look-header",
          "static": true,
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
                "text": "<p>Featured collections</p>"
              }
            }
          ]
        },
        {
          "type": "collections-with-tabs-item"
        },
        {
          "type": "collections-with-tabs-item"
        },
        {
          "type": "collections-with-tabs-item"
        },
        {
          "type": "collections-with-tabs-item"
        },
        {
          "type": "collections-with-tabs-item"
        }
      ]
    }
  ]
}
{% endschema %}
