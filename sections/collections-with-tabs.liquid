{% liquid
  assign section_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_width = 'full-width'
  endif
  assign scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1' | handleize
  assign boxed_scheme = section.settings.boxed_color_scheme.id | default: section.settings.boxed_color_scheme | default: scheme | handleize
%}
<script type="module" src="{{ 'collections-with-tabs.js' | asset_url }}"></script>
<div class="section-spacing collections-with-tabs color-scheme section-color-scope {{ scheme }}{% if section.settings.boxed_layout %} collections-with-tabs--boxed{% endif %}" style="--collections-with-tabs-gap:{{ section.settings.gap_desktop | default: 90 }}px;--collections-with-tabs-gap-mobile:{{ section.settings.gap_mobile | default: 30 }}px;--collections-with-tabs-padding-top:{{ section.settings.padding_top | default: 50 }}px;--collections-with-tabs-padding-bottom:{{ section.settings.padding_bottom | default: 50 }}px;--collections-with-tabs-boxed-y:{{ section.settings.boxed_padding_vertical | default: 70 }}px;--collections-with-tabs-boxed-x:{{ section.settings.boxed_padding_horizontal | default: 70 }}px;--collections-with-tabs-boxed-y-mobile:{{ section.settings.boxed_padding_vertical_mobile | default: 50 }}px;--collections-with-tabs-boxed-x-mobile:{{ section.settings.boxed_padding_horizontal_mobile | default: 20 }}px;{% if section.settings.customize_mobile_padding %}--collections-with-tabs-padding-top-mobile:{{ section.settings.padding_top_mobile | default: 50 }}px;--collections-with-tabs-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile | default: 50 }}px;{% endif %}--collections-with-tabs-image-ratio:{{ section.settings.image_ratio | default: 'auto' }};--collections-with-tabs-progress-duration:{{ section.settings.auto_rotate_speed | default: 6 }}s;" data-collections-with-tabs data-collections-with-tabs-color-scope data-collections-with-tabs-base-scheme="{{ scheme }}" data-auto-rotate="{{ section.settings.auto_rotate }}" data-auto-rotate-speed="{{ section.settings.auto_rotate_speed | default: 6 }}">
  {% if section.settings.background_media != 'none' %}
    <div class="media-background-surface collections-with-tabs__background" aria-hidden="true">
      {% if section.settings.background_media == 'image' and section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      {% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}
        {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x' }}
      {% else %}
        <div class="collections-with-tabs__background-placeholder placeholder-image">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  {% endif %}
  <div class="container {{ section_width }}">
    <div class="collections-with-tabs__box{% if section.settings.boxed_layout %} color-scheme section-color-scope {{ boxed_scheme }}{% endif %}"{% if section.settings.boxed_layout %} data-collections-with-tabs-color-scope data-collections-with-tabs-base-scheme="{{ boxed_scheme }}"{% endif %}>
      <div class="collections-with-tabs__body collections-with-tabs__body--{{ section.settings.image_position | default: 'right' }}">
        <div class="collections-with-tabs__navigation" role="tablist" aria-label="Collections">
          <div class="collections-with-tabs__header">{% content_for 'block', type: 'header', id: 'look-header' %}</div>
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</div>
{% render 'runtime-stylesheet', filename: 'component-runtime-sections-collections-with-tabs.css', section_index: section.index %}
{% schema %}
