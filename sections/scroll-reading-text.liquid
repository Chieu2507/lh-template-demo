{% capture effective_overlay %}{% render 'overlay-background', overlay_settings: section.settings, color_id: 'overlay_color', enabled_id: 'overlay', style_id: 'overlay_style' %}{% endcapture %}
{% assign effective_overlay = effective_overlay | strip %}
{% liquid
  assign section_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_container_width = 'full-width'
  elsif section.settings.section_width == 'full_width_no_padding'
    assign section_container_width = 'full-width full-width--no-padding'
  endif
  assign reading_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'scheme-1' | handleize
  assign reading_background = section.settings.background_color | default: section.settings.color_scheme.settings.background | default: '#ffffff'
  assign reading_alignment = 'center'
  if section.settings.alignment == 'left'
    assign reading_alignment = 'start'
  elsif section.settings.alignment == 'right'
    assign reading_alignment = 'end'
  endif
  assign desktop_height = section.settings.desktop_height | default: 'adapt'
  assign mobile_height = section.settings.mobile_height | default: 'adapt'
  assign content_width = section.settings.content_width | default: 'fill'
%}
{% capture reading_style %}
  --flex-align: {{ reading_alignment }};
  --reading-gap: {{ section.settings.desktop_gap | default: 12 }}px;
  --reading-gap-mobile: {{ section.settings.mobile_gap | default: 12 }}px;
  --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  {% if section.settings.padding_left != blank and section.settings.padding_left != 0 %}--reading-padding-left: {{ section.settings.padding_left }}px;{% endif %}
  {% if section.settings.padding_right != blank and section.settings.padding_right != 0 %}--reading-padding-right: {{ section.settings.padding_right }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --reading-padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --reading-padding-right-mobile: {{ section.settings.padding_right_mobile }}px;
  {% endif %}
  {% if section.settings.background_color != blank %}--reading-background: {{ section.settings.background_color }};{% endif %}
  {% if section.settings.overlay %}--reading-overlay-color: {{ effective_overlay | default: 'transparent' | escape }};{% endif %}
{% endcapture %}
{% style %}
  #shopify-section-{{ section.id }} { background-color: {{ reading_background }}; }
{% endstyle %}
<div class="scroll-reading-text__track" data-scroll-reading-track>
<div data-scroll-reading-panel class="section-spacing value-proposition-01 scroll-reading-text scroll-reading-text--desktop-{{ desktop_height }} scroll-reading-text--mobile-{{ mobile_height }} color-scheme section-color-scope {{ reading_scheme }}" style="{{ reading_style | strip }}">
  {% render 'media-background', media_type: 'image', image: section.settings.background_image, mobile_image: section.settings.mobile_image, aria_hidden: true, alt: '', sizes: '100vw', class: 'scroll-reading-text__background' %}
  {% if section.settings.overlay %}<div class="scroll-reading-text__overlay" aria-hidden="true"></div>{% endif %}
  <div class="container {{ section_container_width }} value-proposition-01__container">
    <div class="value-proposition-01__content align-content scroll-reading-text__content--{{ content_width }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
</div>
{% stylesheet %}
  .scroll-reading-text__track[data-reading-sticky] { min-height: calc(var(--reading-panel-height, 0px) + var(--reading-scroll-distance, 0px)); }
  .scroll-reading-text__track[data-reading-sticky] > .scroll-reading-text { position: sticky; top: var(--reading-sticky-top, 0px); min-height: 100dvh; }
  @media (prefers-reduced-motion: reduce) {
    .scroll-reading-text__track[data-reading-sticky] { min-height: 0; }
    .scroll-reading-text__track[data-reading-sticky] > .scroll-reading-text { position: relative; top: auto; min-height: var(--reading-height, auto); }
  }
  .scroll-reading-text {
    position: relative;
    overflow: clip;
    display: flex;
    align-items: center;
    min-height: var(--reading-height, auto);
    padding-left: var(--reading-padding-left, 0px);
    padding-right: var(--reading-padding-right, 0px);
    background-color: var(--reading-background, var(--background-color));
  }
  .scroll-reading-text--desktop-small { --reading-height: 560px; }
  .scroll-reading-text--desktop-medium { --reading-height: 720px; }
  .scroll-reading-text--desktop-large { --reading-height: 900px; }
  .scroll-reading-text--desktop-full_screen { --reading-height: 100svh; }
  .scroll-reading-text__overlay { position: absolute; inset: 0; background: var(--reading-overlay-color, #000); pointer-events: none; }
  .scroll-reading-text .value-proposition-01__container { position: relative; z-index: 1; }
  .scroll-reading-text .full-width--no-padding { width: 100%; max-width: none; }
  .scroll-reading-text .value-proposition-01__content { width: 100%; gap: var(--reading-gap, 12px); margin-inline: auto; }
  .scroll-reading-text__content--small { max-width: 450px; }
  .scroll-reading-text__content--medium { max-width: 672px; }
  .scroll-reading-text__content--large { max-width: 900px; }
  @media (min-width: 768px) and (max-width: 1149.98px) {
    .scroll-reading-text--desktop-small { --reading-height: 480px; }
    .scroll-reading-text--desktop-medium { --reading-height: 640px; }
    .scroll-reading-text--desktop-large { --reading-height: 800px; }
  }
  @media (max-width: 767.98px) {
    .scroll-reading-text {
      padding-block: var(--section-padding-top-mobile, var(--section-padding-top, 0px)) var(--section-padding-bottom-mobile, var(--section-padding-bottom, 0px));
      padding-left: var(--reading-padding-left-mobile, var(--reading-padding-left, 0px));
      padding-right: var(--reading-padding-right-mobile, var(--reading-padding-right, 0px));
    }
    .scroll-reading-text--mobile-adapt { --reading-height: auto; }
    .scroll-reading-text--mobile-small { --reading-height: 420px; }
    .scroll-reading-text--mobile-medium { --reading-height: 560px; }
    .scroll-reading-text--mobile-large { --reading-height: 640px; }
    .scroll-reading-text--mobile-full_screen { --reading-height: 100svh; }
    .scroll-reading-text .value-proposition-01__content { gap: var(--reading-gap-mobile, var(--reading-gap, 12px)); }
  }
{% endstylesheet %}

