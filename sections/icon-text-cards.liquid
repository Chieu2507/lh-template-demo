{% liquid
  assign section_width = section.settings.section_width | default: 'page_width'
  unless section_width == 'page_width' or section_width == 'full_width' or section_width == 'full_width_no_padding'
    assign section_width = 'page_width'
  endunless

  assign container_width = 'page-width'
  assign container_no_padding = false
  if section_width == 'full_width' or section_width == 'full_width_no_padding'
    assign container_width = 'full-width'
  endif
  if section_width == 'full_width_no_padding'
    assign container_no_padding = true
  endif

  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign color_scheme = section.settings.color_scheme.id
  endif

  assign section_background = section.settings.background_color
  if section_background == blank
    assign section_background = section.settings.color_scheme.settings.background
  endif
  assign section_background = section_background | default: 'var(--background-color)'

  assign alignment = section.settings.alignment | default: 'center'
  assign flex_align = 'flex-start'
  if alignment == 'center'
    assign flex_align = 'center'
  elsif alignment == 'right'
    assign flex_align = 'flex-end'
  endif

  assign mobile_alignment = alignment
  assign mobile_flex_align = flex_align
  if section.settings.customize_mobile_alignment
    assign mobile_alignment = section.settings.alignment_mobile | default: alignment
    if mobile_alignment == 'center'
      assign mobile_flex_align = 'center'
    elsif mobile_alignment == 'right'
      assign mobile_flex_align = 'flex-end'
    else
      assign mobile_flex_align = 'flex-start'
    endif
  endif

  assign content_gap = section.settings.content_gap | default: 40 | plus: 0
  assign content_gap_mobile = content_gap
  if section.settings.customize_mobile_gap
    assign content_gap_mobile = section.settings.content_gap_mobile | default: content_gap | plus: 0
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = padding_top
  assign padding_bottom_mobile = padding_bottom
  if section.settings.customize_mobile_padding
    assign padding_top_mobile = section.settings.padding_top_mobile | default: padding_top | plus: 0
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: padding_bottom | plus: 0
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section_background }};
  }
{% endstyle %}

<div class="icon-text-cards icon-text-cards--{{ section_width }}"{% if section.settings.layout == 'carousel' %} data-icon-text-cards-carousel{% endif %}>
  <div
    class="section-spacing icon-text-cards__spacing color-scheme section-color-scope {{ color_scheme | handleize }}"
    style="--icon-text-cards-text-align: {{ alignment }}; --icon-text-cards-text-align-mobile: {{ mobile_alignment }}; --icon-text-cards-align: {{ flex_align }}; --icon-text-cards-align-mobile: {{ mobile_flex_align }}; --icon-text-cards-gap: {{ content_gap }}px; --icon-text-cards-gap-mobile: {{ content_gap_mobile }}px; --icon-text-cards-padding-top: {{ padding_top }}px; --icon-text-cards-padding-bottom: {{ padding_bottom }}px; --icon-text-cards-padding-top-mobile: {{ padding_top_mobile }}px; --icon-text-cards-padding-bottom-mobile: {{ padding_bottom_mobile }}px;"
  >
    {% if section.settings.background_image != blank %}
      <div class="media-background-surface icon-text-cards__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      </div>
    {% endif %}
    <div class="container {{ container_width }} icon-text-cards__container{% if container_no_padding %} icon-text-cards__container--no-padding{% endif %}">
      <div class="icon-text-cards__content{% if section.settings.layout == 'grid' or section.settings.layout == 'carousel' %} icon-text-cards__content--grid{% endif %}"{% if section.settings.layout == 'grid' or section.settings.layout == 'carousel' %} style="--icon-cards-columns: {{ section.settings.columns_desktop | default: 4 }}; --icon-cards-columns-tablet: {{ section.settings.columns_tablet | default: 2 }}; --icon-cards-columns-mobile: {{ section.settings.columns_mobile | default: 1 }}; --icon-cards-grid-gap: {{ section.settings.grid_gap_desktop | default: 32 }}px; --icon-cards-grid-gap-tablet: {{ section.settings.grid_gap_tablet | default: 20 }}px; --icon-cards-grid-gap-mobile: {{ section.settings.grid_gap_mobile | default: 16 }}px;"{% endif %}>
        {% content_for 'blocks' %}
      </div>
      {% if section.settings.layout == 'carousel' %}
        <div class="icon-text-cards__carousel swiper-carousel__container" hidden
          data-icon-cards-carousel
          data-auto-rotate="{{ section.settings.auto_rotate }}"
          data-rotate-interval="{{ section.settings.autoplay_speed | default: 4 }}"
          data-navigation-position="{{ section.settings.navigation_position | default: 'inside' }}"
          style="--swiper-pagination-spacing: {{ section.settings.pagination_top_padding_desktop | default: 50 }}px; --swiper-pagination-spacing-mobile: {{ section.settings.pagination_top_padding_mobile | default: 24 }}px;{% if section.settings.pagination_thickness == 'thin' %} --swiper-pagination-progressbar-size: 2px;{% endif %}{% if section.settings.pagination_type == 'progress_bar' and section.settings.pagination_limit_width %} --swiper-pagination-width: min(100%, {{ section.settings.pagination_max_width | default: 260 }}px);{% endif %}"
          data-columns-desktop="{{ section.settings.columns_desktop | default: 4 }}"
          data-columns-tablet="{{ section.settings.columns_tablet | default: 2 }}"
          data-columns-mobile="{{ section.settings.columns_mobile | default: 1 }}"
          data-gap-desktop="{{ section.settings.grid_gap_desktop | default: 32 }}"
          data-gap-tablet="{{ section.settings.grid_gap_tablet | default: 20 }}"
          data-gap-mobile="{{ section.settings.grid_gap_mobile | default: 16 }}"
          data-pagination-type="{{ section.settings.pagination_type | default: 'progress_bar' }}"
          data-pagination-label="{{ 'carousel.go_to_slide' | t: index: '[index]' | escape }}"
        >
          {% capture icon_cards_pagination %}
            {% if section.settings.show_pagination_on_desktop %}
              {% render 'swiper-pagination', type: section.settings.pagination_type, class: 'icon-text-cards__pagination', attributes: 'data-icon-cards-pagination' %}
            {% endif %}
          {% endcapture %}
          {% assign icon_cards_id = 'IconCards-' | append: section.id %}
          {% assign icon_cards_label = 'general.icon_text_cards' | t %}
          {% render 'swiper-carousel', id: icon_cards_id, root_class: 'icon-text-cards__viewport', aria_label: icon_cards_label, pagination: icon_cards_pagination %}
          {% if section.settings.show_navigation_on_desktop %}
            {% liquid
              assign navigation_position = section.settings.navigation_position | default: 'inside'
              assign navigation_centered = true
              assign navigation_behavior = section.settings.navigation_behavior | default: 'show_on_hover'
              if navigation_position == 'top'
                assign navigation_centered = false
              elsif navigation_position == 'bottom'
                assign navigation_centered = false
              endif
              assign navigation_class = 'icon-text-cards__navigation icon-text-cards__navigation--' | append: navigation_position
              assign pagination_size = 'var(--swiper-pagination-progressbar-size, 4px)'
              if section.settings.pagination_type == 'bullets'
                assign pagination_size = 'var(--swiper-pagination-bullet-size, 0.5rem)'
              endif
            %}
            {% capture navigation_center_style %}{% if navigation_centered and section.settings.show_pagination_on_desktop %}--swiper-navigation-center-offset: calc(({{ section.settings.pagination_top_padding_desktop | default: 50 }}px + {{ pagination_size }}) / 2);{% endif %}{% endcapture %}
            {% render 'swiper-navigation', position: navigation_position, style: section.settings.navigation_style, icon: section.settings.navigation_icon, behavior: navigation_behavior, centered: navigation_centered, wrapper_class: navigation_class, wrapper_attributes: 'data-icon-cards-navigation', center_style: navigation_center_style %}
          {% endif %}
        </div>
        <script type="application/json" data-theme-module="{{ 'icon-text-cards.js' | asset_url }}"></script>
      {% endif %}
    </div>
  </div>
</div>

{% render 'component-stylesheet', filename: 'component-sections-icon-text-cards.css', section_index: section.index %}

