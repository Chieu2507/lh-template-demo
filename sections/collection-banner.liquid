{% liquid
 assign banner_image = collection.image
 if section.settings.image_source == 'custom'
  assign banner_image = section.settings.image
 endif
 assign banner_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme
%}
{% style %}#shopify-section-{{ section.id }}{background:{{ section.settings.background_color | default: section.settings.color_scheme.settings.background }}}{% endstyle %}
<div class="collection-banner collection-banner--{{ section.settings.layout }} color-scheme section-color-scope {{ banner_scheme }} section-spacing {% if section.settings.section_width == 'page' %}container page-width{% endif %}" style="--banner-height:{{ section.settings.height_desktop }}px;--banner-height-mobile:{{ section.settings.height_mobile }}px;--banner-gap:{{ section.settings.item_gap }}px;--banner-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--banner-overlay-color:{{ section.settings.overlay_color }};--banner-position:{{ section.settings.content_position }};--text-align-default:{{ section.settings.content_alignment }};--section-padding-top:{{ section.settings.padding_top }}px;--section-padding-bottom:{{ section.settings.padding_bottom }}px">
{% if banner_image != blank %}<div class="collection-banner__media"><picture>{% if section.settings.mobile_image != blank %}<source media="(max-width:767.98px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ banner_image | image_url: width: 2400 | image_tag: widths: '400,750,1100,1600,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'collection-banner__image' }}</picture></div>{% endif %}
<div class="collection-banner__content">
{% content_for 'block', type: '_collection-breadcrumb', id: 'breadcrumbs' %}
{% content_for 'block', type: 'heading', id: 'title' %}
{% content_for 'block', type: 'text', id: 'description' %}
</div></div>
{% stylesheet %}
.collection-banner{position:relative;display:grid;isolation:isolate;min-height:var(--banner-height,600px);overflow:hidden}
.collection-banner__media{min-width:0;min-height:0;position:relative}.collection-banner__image{display:block;width:100%;height:100%;object-fit:cover}.collection-banner__media picture{display:contents}
.collection-banner__content{display:flex;flex-direction:column;gap:var(--banner-gap,16px);justify-content:var(--banner-position,flex-end);align-items:var(--text-align-default,left);text-align:var(--text-align-default,left);padding:50px var(--page-margin);min-width:0}
.collection-banner--background .collection-banner__media{position:absolute;inset:0;z-index:-2}.collection-banner--background:has(.collection-banner__media):after{content:'';position:absolute;inset:0;background:var(--banner-overlay-color,#000);opacity:var(--banner-overlay,.2);z-index:-1;pointer-events:none}
.collection-banner--split{grid-template-columns:1fr 1fr}.collection-banner--classic{min-height:0}.collection-banner--classic .collection-banner__media{height:var(--banner-height)}
.collection-banner__breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:var(--font-body-sm);color:var(--body-color)}.collection-banner__breadcrumb a{color:inherit;text-decoration:none}.collection-banner__breadcrumb a:hover{text-decoration:underline}
@media(min-width:768px) and (max-width:1149.98px){.collection-banner__content{padding-block:38px}}
@media(max-width:767.98px){.collection-banner{min-height:var(--banner-height-mobile,300px)}.collection-banner--split{grid-template-columns:1fr}.collection-banner--split .collection-banner__media,.collection-banner--classic .collection-banner__media{height:var(--banner-height-mobile)}.collection-banner__content{padding-block:24px}.collection-banner--classic{min-height:0}}
{% endstylesheet %}
{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "image_source",
      "label": "Image source",
      "options": [
        {
          "value": "collection",
          "label": "Collection image"
        },
        {
          "value": "custom",
          "label": "Custom image"
        }
      ],
      "default": "collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.image_source == 'custom' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "background",
          "label": "Background"
        },
        {
          "value": "split",
          "label": "Split"
        }
      ],
      "default": "background"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 300
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Item gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection banner",
      "blocks": {
        "breadcrumbs": {
          "type": "_collection-breadcrumb",
          "static": true,
          "settings": {}
        },
        "title": {
          "type": "heading",
          "static": true,
          "settings": {
            "text": "<p>{{ collection.title }}</p>",
            "html_tag": "h1",
            "heading_size": "xl"
          }
        },
        "description": {
          "type": "text",
          "static": true,
          "settings": {
            "text": "<p>{{ collection.description }}</p>"
          }
        }
      }
    }
  ]
}
{% endschema %}
