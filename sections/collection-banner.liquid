{% liquid
  assign banner_image = collection.featured_image | default: collection.products.first.featured_image
  if section.settings.image_source == 'custom'
    assign banner_image = section.settings.image
  endif

  assign banner_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme
  assign banner_height_desktop = 600
  case section.settings.height_desktop
    when 'extra_small'
      assign banner_height_desktop = 320
    when 'small'
      assign banner_height_desktop = 420
    when 'medium'
      assign banner_height_desktop = 520
    when 'extra_large'
      assign banner_height_desktop = 720
  endcase

  assign banner_height_mobile = 240
  case section.settings.height_mobile
    when 'small'
      assign banner_height_mobile = 300
    when 'medium'
      assign banner_height_mobile = 360
    when 'large'
      assign banner_height_mobile = 440
    when 'extra_large'
      assign banner_height_mobile = 520
  endcase

  assign banner_position_x = 'flex-start'
  assign banner_position_y = 'center'
  assign banner_text_align = 'left'
  case section.settings.content_position
    when 'center-center'
      assign banner_position_x = 'center'
      assign banner_text_align = 'center'
    when 'center-right'
      assign banner_position_x = 'flex-end'
      assign banner_text_align = 'right'
    when 'bottom-left'
      assign banner_position_y = 'flex-end'
    when 'bottom-center'
      assign banner_position_x = 'center'
      assign banner_position_y = 'flex-end'
      assign banner_text_align = 'center'
    when 'bottom-right'
      assign banner_position_x = 'flex-end'
      assign banner_position_y = 'flex-end'
      assign banner_text_align = 'right'
  endcase
%}
{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color | default: section.settings.color_scheme.settings.background }};
  }
  {% if section.settings.transparent_header %}
    body:has(#MainContent > #shopify-section-{{ section.id }}:first-child .collection-banner--transparent-header) .section-header.header {
      z-index: var(--z-drawer);
      margin-block-end: calc(var(--header-layout-height, 0px) * -1);
      background-color: transparent;
    }
  {% endif %}
{% endstyle %}
<div
  class="collection-banner collection-banner--{{ section.settings.layout }}{% if section.settings.show_overlay %} collection-banner--overlay{% endif %}{% if section.settings.transparent_header %} collection-banner--transparent-header{% endif %} color-scheme section-color-scope {{ banner_scheme }} section-spacing{% if section.settings.section_width == 'page' %} container page-width{% elsif section.settings.section_width == 'full' %} container full-width{% endif %}"
  style="--banner-height:{{ banner_height_desktop }}px;--banner-height-mobile:{{ banner_height_mobile }}px;--banner-gap:{{ section.settings.gap_desktop }}px;--banner-gap-mobile:{{ section.settings.gap_mobile }}px;--banner-overlay:1;--banner-overlay-color:{{ section.settings.overlay_color }};--banner-position-x:{{ banner_position_x }};--banner-position-y:{{ banner_position_y }};--text-align-default:{{ banner_text_align }};--section-padding-top:{{ section.settings.padding_top }}px;--section-padding-bottom:{{ section.settings.padding_bottom }}px;--section-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;--section-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px"
>
  {% if banner_image != blank %}
    <div class="collection-banner__media">
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source media="(max-width: 767.98px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
        {% endif %}
        {{ banner_image | image_url: width: 2400 | image_tag: widths: '400, 750, 1100, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'collection-banner__image' }}
      </picture>
    </div>
  {% else %}
    <div class="collection-banner__media collection-banner__media--placeholder">
      {{ 'collection-1' | placeholder_svg_tag: 'collection-banner__image' }}
    </div>
  {% endif %}
  <div class="collection-banner__content{% unless section.settings.full_width_content %} collection-banner__content--contained{% endunless %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .collection-banner {
    position: relative;
    display: grid;
    isolation: isolate;
    min-height: var(--banner-height, 600px);
    overflow: hidden;
  }

  .collection-banner__media {
    position: relative;
    min-width: 0;
    min-height: 0;
  }

  .collection-banner__media picture {
    display: contents;
  }

  .collection-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-banner__media--placeholder {
    background: color-mix(in srgb, var(--heading-color) 8%, var(--background-color));
  }

  .collection-banner--background .collection-banner__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .collection-banner--background.collection-banner--overlay .collection-banner__media::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--banner-overlay-color, #000);
    opacity: var(--banner-overlay, 0.2);
    content: '';
    pointer-events: none;
  }

  .collection-banner--background .collection-banner__media img,
  .collection-banner--background .collection-banner__media svg {
    position: absolute;
    inset: 0;
  }

  .collection-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-width: 0;
    min-height: inherit;
    flex-direction: column;
    align-items: var(--banner-position-x, flex-start);
    justify-content: var(--banner-position-y, flex-end);
    gap: var(--banner-gap, 16px);
    padding: 50px var(--page-margin);
    text-align: var(--text-align-default, left);
  }

  .collection-banner__content--contained {
    width: min(100%, var(--page-width, 1440px));
    margin-inline: auto;
  }

  .collection-banner--classic {
    min-height: 0;
  }

  .collection-banner--classic .collection-banner__media {
    height: var(--banner-height, 600px);
  }

  .collection-banner--split {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .collection-banner--split .collection-banner__media,
  .collection-banner--split .collection-banner__content {
    grid-row: 1;
  }

  .collection-banner--split .collection-banner__content {
    grid-column: 2;
  }

  .collection-banner__breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--body-color);
    text-align: inherit;
    padding-block: var(--breadcrumb-padding-top, 0px) var(--breadcrumb-padding-bottom, 0px);
  }

  .collection-banner__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .collection-banner__breadcrumb a:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) and (max-width: 1023.98px) {
    .collection-banner__content {
      padding-block: 38px;
    }
  }

  @media (max-width: 767.98px) {
    .collection-banner {
      min-height: var(--banner-height-mobile, 240px);
    }

    .collection-banner__content {
      gap: var(--banner-gap-mobile, var(--banner-gap, 16px));
      padding-block: 24px;
    }

    .collection-banner__breadcrumb.collection-banner__breadcrumb--custom-mobile-padding {
      padding-block: var(--breadcrumb-padding-top-mobile, var(--breadcrumb-padding-top, 0px)) var(--breadcrumb-padding-bottom-mobile, var(--breadcrumb-padding-bottom, 0px));
    }

    .collection-banner--classic {
      min-height: 0;
    }

    .collection-banner--classic .collection-banner__media {
      height: var(--banner-height-mobile, 240px);
    }

    .collection-banner--split {
      grid-template-columns: minmax(0, 1fr);
    }

    .collection-banner--split .collection-banner__media,
    .collection-banner--split .collection-banner__content {
      grid-column: 1;
      grid-row: auto;
    }

    .collection-banner--split .collection-banner__media {
      height: var(--banner-height-mobile, 240px);
    }

    .collection-banner--split .collection-banner__content {
      min-height: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "max_blocks": 3,
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    { "type": "_collection-breadcrumb" },
    { "type": "heading" },
    { "type": "text" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "image_source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "Default" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "collection"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "visible_if": "{{ section.settings.image_source == 'custom' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full" },
        { "value": "full_bleed", "label": "Full (no padding)" }
      ],
      "default": "full_bleed"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "classic", "label": "Classic" },
        { "value": "background", "label": "Background" },
        { "value": "split", "label": "Split" }
      ],
      "default": "background"
    },
    {
      "type": "checkbox",
      "id": "full_width_content",
      "label": "Full-width content",
      "default": true
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "center-left", "label": "Center left" },
        { "value": "center-center", "label": "Center center" },
        { "value": "center-right", "label": "Center right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Allow transparent header",
      "info": "This setting applies when this section is first on the page.",
      "default": false
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Collection image"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Overlay",
      "default": true
    },
    {
  "type": "color",
  "id": "overlay_color",
  "label": "Overlay color",
  "alpha": true,
  "default": "#00000033",
  "visible_if": "{{ section.settings.show_overlay }}"
},

    {
      "type": "select",
      "id": "height_desktop",
      "label": "Desktop height",
      "options": [
        { "value": "extra_small", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra_large", "label": "Extra large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Mobile height",
      "options": [
        { "value": "extra_small", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra_large", "label": "Extra large" }
      ],
      "default": "extra_small"
    },
    { "type": "header", "content": "Appearance" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Content color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "Background color"
    },
    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "Custom for mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Collection banner",
      "blocks": [
        {
          "type": "_collection-breadcrumb",
          "settings": {
            "separator": "·",
            "text_size": "sm"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>{{ collection.title }}</p>",
            "html_tag": "h1",
            "heading_size": "xl"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>{{ collection.description }}</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
