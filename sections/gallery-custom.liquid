{% liquid
  assign section_width = section.settings.section_width | default: 'full_width_no_padding'
  assign container_width = 'page-width'
  if section_width != 'page_width'
    assign container_width = 'full-width'
  endif
  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign color_scheme = section.settings.color_scheme.id
  endif
  assign padding_top_mobile = section.settings.padding_top
  assign padding_bottom_mobile = section.settings.padding_bottom
  if section.settings.customize_mobile_padding
    assign padding_top_mobile = section.settings.padding_top_mobile
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  endif
%}
{% if section.settings.background_color != blank %}
  {% style %}#shopify-section-{{ section.id }} { background-color: {{ section.settings.background_color }}; }{% endstyle %}
{% endif %}
<div class="gallery-custom gallery-carousel gallery-carousel--{{ section_width }}">
  <div class="section-spacing gallery-carousel__spacing color-scheme section-color-scope {{ color_scheme | handleize }}"
    style="--gallery-marquee-width: {% if section.settings.marquee_full_bleed == false %}100%{% else %}100cqw{% endif %}; --gallery-carousel-section-padding-top: {{ section.settings.padding_top }}px; --gallery-carousel-section-padding-bottom: {{ section.settings.padding_bottom }}px; --gallery-carousel-section-padding-top-mobile: {{ padding_top_mobile }}px; --gallery-carousel-section-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% if section.settings.background_color != blank %} --gallery-carousel-section-background: {{ section.settings.background_color }};{% endif %}">
    {% if section.settings.background_image != blank %}
      <div class="media-background-surface gallery-carousel__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: loading: 'lazy' }}
      </div>
    {% endif %}
    <div class="container {{ container_width }} gallery-carousel__container{% if section_width == 'full_width_no_padding' %} gallery-carousel__container--no-padding{% endif %}">
      <div class="gallery-carousel__content gallery-carousel__content--vertical">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>
{% render 'component-stylesheet', filename: 'component-sections-gallery-carousel.css', section_index: section.index %}

{% schema %}
{
  "name": "Gallery (custom)",
  "class": "section-kernel",
  "enabled_on": {
    "templates": [
      "index",
      "page",
      "product",
      "collection"
    ]
  },
  "max_blocks": 50,
  "blocks": [
    {
      "type": "marquee"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        },
        {
          "value": "full_width_no_padding",
          "label": "Full width (no padding)"
        }
      ],
      "default": "full_width_no_padding"
    },
    {
      "type": "checkbox",
      "id": "marquee_full_bleed",
      "label": "Extend marquee to section edges",
      "default": true
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 112
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Gallery (custom)",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "marquee",
          "settings": {
            "use_elara_layout": false,
            "show_top_divider": false,
            "show_bottom_divider": false,
            "show_blurred_edges": false,
            "enable_parallax": false,
            "alignment": "center",
            "animation_speed": 0.6,
            "animation_direction": "forward",
            "gap_desktop": 64,
            "gap_mobile": 48,
            "width": "fill",
            "color_type": "inherit",
            "padding_top": 0,
            "padding_bottom": 0,
            "padding_left": 0,
            "padding_right": 0,
            "customize_mobile_padding": true,
            "padding_top_mobile": 0,
            "padding_bottom_mobile": 0,
            "padding_left_mobile": 0,
            "padding_right_mobile": 0
          },
          "blocks": [
            {
              "type": "_marquee-image",
              "settings": {
                "image_ratio": "ratio_1_1",
                "image_link": "",
                "open_in_new_tab": false,
                "width_custom_desktop": 160,
                "width_custom_mobile": 120,
                "corner_radius": "custom",
                "custom_corner_radius": 12,
                "rotate": 10
              }
            },
            {
              "type": "_marquee-image",
              "settings": {
                "image_ratio": "ratio_1_1",
                "image_link": "",
                "open_in_new_tab": false,
                "width_custom_desktop": 160,
                "width_custom_mobile": 120,
                "corner_radius": "custom",
                "custom_corner_radius": 12,
                "rotate": -10
              }
            },
            {
