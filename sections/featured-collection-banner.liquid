{% liquid
  assign featured_collection_banner_section_width = section.settings.section_width | default: 'page_width'
  unless featured_collection_banner_section_width == 'page_width' or featured_collection_banner_section_width == 'full_width' or featured_collection_banner_section_width == 'full_width_no_padding'
    assign featured_collection_banner_section_width = 'page_width'
  endunless

  assign featured_collection_banner_container_width = 'page-width'
  if featured_collection_banner_section_width == 'full_width' or featured_collection_banner_section_width == 'full_width_no_padding'
    assign featured_collection_banner_container_width = 'full-width'
  endif
  assign featured_collection_banner_no_padding = false
  if featured_collection_banner_section_width == 'full_width_no_padding'
    assign featured_collection_banner_no_padding = true
  endif

  assign featured_collection_banner_size = section.settings.banner_max_width | default: 'medium' | append: ''
  case featured_collection_banner_size
    when '450'
      assign featured_collection_banner_size = 'small'
    when '612'
      assign featured_collection_banner_size = 'medium'
    when '800', '1000'
      assign featured_collection_banner_size = 'large'
  endcase
  unless featured_collection_banner_size == 'small' or featured_collection_banner_size == 'medium' or featured_collection_banner_size == 'large'
    assign featured_collection_banner_size = 'medium'
  endunless
  assign featured_collection_banner_header_gap_desktop = section.settings.header_gap_desktop | default: 30
  assign featured_collection_banner_header_gap_mobile = section.settings.header_gap_mobile | default: 20

  assign featured_collection_banner_position = section.settings.banner_position | default: 'before'
  unless featured_collection_banner_position == 'before' or featured_collection_banner_position == 'after'
    assign featured_collection_banner_position = 'before'
  endunless

  assign featured_collection_banner_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign featured_collection_banner_scheme = section.settings.color_scheme.id
  endif
  assign featured_collection_banner_scheme = featured_collection_banner_scheme | default: 'scheme-1' | handleize

  assign featured_collection_banner_gap_desktop = section.settings.gap_desktop | default: 30 | plus: 0
  if featured_collection_banner_gap_desktop < 0 or featured_collection_banner_gap_desktop > 100
    assign featured_collection_banner_gap_desktop = 30
  endif
  assign featured_collection_banner_gap_mobile = section.settings.gap_mobile | default: 20 | plus: 0
  if featured_collection_banner_gap_mobile < 0 or featured_collection_banner_gap_mobile > 100
    assign featured_collection_banner_gap_mobile = 20
  endif

  assign featured_collection_banner_padding_top = section.settings.padding_top | default: 50 | plus: 0
  assign featured_collection_banner_padding_bottom = section.settings.padding_bottom | default: 50 | plus: 0
  assign featured_collection_banner_padding_top_mobile = featured_collection_banner_padding_top
  assign featured_collection_banner_padding_bottom_mobile = featured_collection_banner_padding_bottom

  if featured_collection_banner_padding_top < 0 or featured_collection_banner_padding_top > 100
    assign featured_collection_banner_padding_top = 50
  endif
  if featured_collection_banner_padding_bottom < 0 or featured_collection_banner_padding_bottom > 100
    assign featured_collection_banner_padding_bottom = 50
  endif
  if section.settings.customize_mobile_padding
    assign featured_collection_banner_padding_top_mobile = section.settings.padding_top_mobile | default: featured_collection_banner_padding_top | plus: 0
    assign featured_collection_banner_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: featured_collection_banner_padding_bottom | plus: 0
    if featured_collection_banner_padding_top_mobile < 0 or featured_collection_banner_padding_top_mobile > 100
      assign featured_collection_banner_padding_top_mobile = featured_collection_banner_padding_top
    endif
    if featured_collection_banner_padding_bottom_mobile < 0 or featured_collection_banner_padding_bottom_mobile > 100
      assign featured_collection_banner_padding_bottom_mobile = featured_collection_banner_padding_bottom
    endif
  endif
%}

{% capture featured_collection_banner_style %}
  {% if featured_collection_banner_header_gap_desktop != 30 %}--featured-collection-banner-header-gap-desktop: {{ featured_collection_banner_header_gap_desktop }}px;{% endif %}
  {% if featured_collection_banner_header_gap_mobile != 20 %}--featured-collection-banner-header-gap-mobile: {{ featured_collection_banner_header_gap_mobile }}px;{% endif %}
  {% if featured_collection_banner_gap_desktop != 30 %}--featured-collection-banner-gap-desktop: {{ featured_collection_banner_gap_desktop }}px;{% endif %}
  {% if featured_collection_banner_gap_mobile != 20 %}--featured-collection-banner-gap-mobile: {{ featured_collection_banner_gap_mobile }}px;{% endif %}
  {% if featured_collection_banner_padding_top != 50 %}--featured-collection-banner-padding-top: {{ featured_collection_banner_padding_top }}px;{% endif %}
  {% if featured_collection_banner_padding_bottom != 50 %}--featured-collection-banner-padding-bottom: {{ featured_collection_banner_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if featured_collection_banner_padding_top_mobile != featured_collection_banner_padding_top %}--featured-collection-banner-padding-top-mobile: {{ featured_collection_banner_padding_top_mobile }}px;{% endif %}
    {% if featured_collection_banner_padding_bottom_mobile != featured_collection_banner_padding_bottom %}--featured-collection-banner-padding-bottom-mobile: {{ featured_collection_banner_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign featured_collection_banner_style = featured_collection_banner_style | strip %}

<div
  class="section-spacing featured-collection-banner__spacing color-scheme section-color-scope {{ featured_collection_banner_scheme }}"
  {% if featured_collection_banner_style != blank %}style="{{ featured_collection_banner_style }}"{% endif %}
>
  <div class="container {{ featured_collection_banner_container_width }} featured-collection-banner__container{% if featured_collection_banner_no_padding %} featured-collection-banner__container--no-padding{% endif %}">
    <div class="featured-collection-banner__content">
      <div class="featured-collection-banner__header">
        {% content_for 'block', type: 'header', id: 'header' %}
      </div>
      <div class="featured-collection-banner__layout" data-banner-size="{{ featured_collection_banner_size }}" data-banner-position="{{ featured_collection_banner_position }}" data-banner-height="{{ section.settings.banner_height | default: 'ratio' }}">
        <div class="featured-collection-banner__banner">
          {% content_for 'block', type: 'banner', id: 'banner' %}
        </div>
        <div class="featured-collection-banner__products">
          {% content_for 'block', type: 'product-list-banner', id: 'product-list' %}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .featured-collection-banner__spacing {
    width: 100%;
    padding-top: var(--featured-collection-banner-padding-top, 50px);
    padding-bottom: var(--featured-collection-banner-padding-bottom, 50px);
  }

  .featured-collection-banner__container {
    min-width: 0;
  }

  .container.full-width.featured-collection-banner__container--no-padding {
    padding-inline: 0;
  }

  .featured-collection-banner__content {
    display: grid;
    gap: var(--featured-collection-banner-header-gap-mobile, 20px);
    min-width: 0;
  }

  .featured-collection-banner__header {
    min-width: 0;
  }

  .featured-collection-banner__layout {
    --featured-collection-banner-max-width: 612px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'banner'
      'products';
    gap: var(--featured-collection-banner-gap-mobile, 20px);
    min-width: 0;
  }

  .featured-collection-banner__layout[data-banner-size='small'] {
    --featured-collection-banner-max-width: 450px;
  }

  .featured-collection-banner__layout[data-banner-size='large'] {
    --featured-collection-banner-max-width: 800px;
  }

  .featured-collection-banner__layout[data-banner-position='after'] {
    grid-template-areas:
      'products'
      'banner';
  }

  .featured-collection-banner__banner,
  .featured-collection-banner__products {
    min-width: 0;
  }

  .featured-collection-banner__banner {
    grid-area: banner;
  }

  .featured-collection-banner__products {
    grid-area: products;
  }

  @media (min-width: 768px) {
    .featured-collection-banner__content {
      gap: var(--featured-collection-banner-header-gap-desktop, 30px);
    }

    .featured-collection-banner__layout {
      grid-template-columns: minmax(0, min(50% - var(--featured-collection-banner-gap-desktop, 30px) / 2, var(--featured-collection-banner-max-width, 612px))) minmax(0, 1fr);
      grid-template-areas: 'banner products';
      gap: var(--featured-collection-banner-gap-desktop, 30px);
      align-items: stretch;
    }

    .featured-collection-banner__banner,
    .featured-collection-banner__products {
      position: sticky;
      top: calc(var(--header-sticky-height, 0px) + var(--sticky-offset-spacing, 16px));
      align-self: start;
    }

    .featured-collection-banner__layout[data-banner-position='after'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, min(50% - var(--featured-collection-banner-gap-desktop, 30px) / 2, var(--featured-collection-banner-max-width, 612px)));
      grid-template-areas: 'products banner';
    }

  }

  @media (min-width: 768px) {
    .featured-collection-banner__layout[data-banner-height='products'] .featured-collection-banner__banner {
      position: relative;
      top: auto;
      align-self: stretch;
    }

    .featured-collection-banner__layout[data-banner-height='products'] .image-card--featured-collection-banner {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  @media (max-width: 767.98px) {
    .featured-collection-banner__spacing {
      padding-top: var(--featured-collection-banner-padding-top-mobile, var(--featured-collection-banner-padding-top, 50px));
      padding-bottom: var(--featured-collection-banner-padding-bottom-mobile, var(--featured-collection-banner-padding-bottom, 50px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection_banner",
  "class": "section-featured-collection-banner",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "max_blocks": 3,
  "blocks": [
    {
      "type": "header"
    },
    {
      "type": "banner"
    },
    {
      "type": "product-list-banner"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:options.section_width.page_width"
        },
        {
          "value": "full_width",
          "label": "t:options.section_width.full_width"
        },
        {
          "value": "full_width_no_padding",
          "label": "t:options.section_width.full_width_no_padding"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "banner_position",
      "label": "t:labels.banner_position",
      "options": [
        {
          "value": "before",
          "label": "t:options.banner_position.before"
        },
        {
          "value": "after",
          "label": "t:options.banner_position.after"
        }
      ],
      "default": "before"
    },
    {
      "type": "select",
      "id": "banner_max_width",
      "label": "Banner maximum width",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        {
          "value": "ratio",
          "label": "Image ratio"
        },
        {
          "value": "products",
          "label": "Match product grid"
        }
      ],
      "default": "ratio"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_gap_desktop",
      "label": "Desktop header gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "header_gap_mobile",
      "label": "Mobile header gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:options.position.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:options.position.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Featured collection: Banner",
      "category": "t:general.collection",
      "settings": {
        "section_width": "page_width",
        "banner_position": "before",
        "gap_desktop": 30,
        "gap_mobile": 20,
        "color_scheme": "scheme-1",
        "padding_top": 50,
        "padding_bottom": 50,
        "customize_mobile_padding": false
      },
      "blocks": [
        {
          "type": "header",
          "id": "header",
          "static": true,
          "settings": {
            "width": "fill",
            "alignment": "center",
            "gap_desktop": 8,
            "gap_mobile": 8
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
                "text": "<p>SECTION TAG</p>"
              }
            },
            {
              "type": "heading",
              "settings": {
                "text": "<p>Main Heading Text Placeholder</p>",
                "heading_size": "lg",
                "html_tag": "h2",
                "width": "fit"
              }
            }
          ]
        },
        {
          "type": "banner",
          "id": "banner",
          "static": true,
          "settings": {
            "background_type": "image",
            "show_overlay": false,
            "color_scheme": "scheme-3",
            "image_ratio_desktop": "square",
            "image_ratio_mobile": "square",
            "position_desktop": "bottom_left",
            "position_mobile": "bottom_left",
            "padding_top": 32,
            "padding_bottom": 32,
            "padding_left": 32,
            "padding_right": 32,
            "gap_desktop": 20,
            "gap_mobile": 16
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
                "text": "<p>Subheading</p>"
              }
            },
            {
              "type": "heading",
              "settings": {
                "text": "<p>Your Main Heading Goes Here</p>",
                "heading_size": "lg",
                "html_tag": "h2",
                "width": "fill"
              }
            },
            {
              "type": "button",
              "settings": {
                "button_label": "Button label",
                "button_style": "tertiary",
                "width": "fit",
                "show_icon": true,
                "icon": "arrow",
                "icon_position": "after",
                "icon_size": "inherit"
              }
            }
          ]
