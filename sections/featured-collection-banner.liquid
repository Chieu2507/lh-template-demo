        {
          "type": "product-list-banner",
          "id": "product-list",
          "static": true,
          "settings": {
            "collection": "",
            "max_products": 6,
            "columns_mobile": "2",
            "enable_swipe_mobile": true,
            "gap_horizontal": 12,
            "gap_vertical": 28,
            "gap_horizontal_mobile": 8,
            "gap_vertical_mobile": 24
          },
          "blocks": [
            {
              "type": "product-card",
              "id": "product-card",
              "static": true,
              "settings": {
                "color_type": "inherit",
                "color_scheme": "scheme-1"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
