{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{% style %}#shopify-section-{{ section.id }}{background:{{ section.settings.background_color | default: section.settings.color_scheme.settings.background }}}{% endstyle %}
<div class="main-collection main-collection--blocks section-spacing color-scheme section-color-scope {{ section.settings.color_scheme }}" style="--section-padding-top:{{ section.settings.padding_top }}px;--section-padding-bottom:{{ section.settings.padding_bottom }}px;--collection-gap:{{ section.settings.item_gap }}px">
<collection-facets class="main-collection__facets container {% if section.settings.section_width == 'page' %}page-width{% else %}full-width{% endif %}" data-section-id="{{ section.id }}">
{% content_for 'block', type: '_collection-toolbar', id: 'toolbar' %}
{% content_for 'block', type: '_collection-products', id: 'products' %}
</collection-facets></div>
<script src="{{ 'section-collection.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Collection page",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 2,
      "max": 40,
      "step": 2,
      "default": 10
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Item gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 120,
      "unit": "px"
    }
  ]
}
{% endschema %}
