{% liquid
  assign navigation_style = section.settings.navigation_style | default: 'secondary'
  unless navigation_style == 'primary' or navigation_style == 'secondary' or navigation_style == 'outline' or navigation_style == 'icon_only'
    assign navigation_style = 'secondary'
  endunless
  assign navigation_variant = navigation_style
  assign navigation_modifier = ''
  if navigation_style == 'icon_only'
    assign navigation_variant = 'tertiary'
    assign navigation_modifier = 'swiper-nav-button--icon-only'
  elsif navigation_style == 'outline'
    assign navigation_variant = 'tertiary'
    assign navigation_modifier = 'swiper-nav-button--outline'
  endif
  assign navigation_icon = section.settings.navigation_icon | default: 'arrow'
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign boxed_scheme = section.settings.boxed_color_scheme | default: 'scheme-1'
  assign boxed_radius = 'var(--radius-rounded)'
  case section.settings.corner_radius
    when 'radius_2', 'radius_4', 'radius_6', 'radius_8', 'radius_12', 'radius_16', 'radius_24', 'radius_32'
      assign boxed_radius = section.settings.corner_radius | replace: 'radius_', 'var(--radius-' | append: ')'
    when 'square'
      assign boxed_radius = 'var(--radius-square)'
    when 'slightly_rounded'
      assign boxed_radius = 'var(--radius-slight)'
    when 'pill'
      assign boxed_radius = 'var(--radius-pill)'
  endcase
  assign boxed_shadow = 'none'
  case section.settings.shadow
    when 'small'
      assign boxed_shadow = '0 0.25rem 0.75rem color-mix(in srgb, var(--shadow-color) 12%, transparent)'
    when 'medium'
      assign boxed_shadow = '0 0.5rem 1.25rem color-mix(in srgb, var(--shadow-color) 18%, transparent)'
    when 'large'
      assign boxed_shadow = '0 1rem 2rem color-mix(in srgb, var(--shadow-color) 24%, transparent)'
  endcase
  assign container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign container_width = 'full-width'
  endif
%}
{% style %}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background_color | default: section.settings.color_scheme.settings.background }}; }
{% endstyle %}
<div class="section-spacing multiple-images-text color-scheme section-color-scope {{ scheme }}" style="--multi-gap:{{ section.settings.gap_desktop }}px;--multi-gap-mobile:{{ section.settings.gap_mobile }}px;--multi-padding-top:{{ section.settings.padding_top }}px;--multi-padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.customize_mobile_padding %}--multi-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;--multi-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;{% endif %}{% if section.settings.background_color != blank %}background-color:{{ section.settings.background_color }};{% endif %}">
  <div class="container {{ container_width }}">
  <multiple-images-text class="multiple-images-text__layout{% if section.settings.desktop_content_position == 'first' %} multiple-images-text__layout--content-first{% endif %}{% if section.settings.enable_boxed_layout %} multiple-images-text__layout--boxed color-scheme section-color-scope {{ boxed_scheme }}{% endif %}"{% if section.settings.enable_boxed_layout %} style="--multi-box-radius:{{ boxed_radius }};--multi-box-shadow:{{ boxed_shadow }};--multi-box-padding-block:{{ section.settings.boxed_padding_block | default: 70 }}px;--multi-box-padding-inline:{{ section.settings.boxed_padding_inline | default: 70 }}px;--multi-box-padding-block-mobile:{{ section.settings.boxed_padding_block_mobile | default: 50 }}px;--multi-box-padding-inline-mobile:{{ section.settings.boxed_padding_inline_mobile | default: 30 }}px;"{% endif %} role="region" aria-label="{{ 'accessibility.multiple_images_text' | t | escape }}">
    <div class="multiple-images-text__images" data-multi-images></div>
    <div class="multiple-images-text__items" data-multi-items>{% content_for 'blocks' %}</div>
    {% if section.settings.show_navigation %}
      <div class="multiple-images-text__navigation" data-multi-navigation>
        <button class="btn btn-{{ navigation_variant }} btn--{{ navigation_variant }} btn--icon {{ navigation_modifier }} swiper-nav-button" type="button" data-multi-previous aria-label="{{ 'collection_tabs.previous' | t | escape }}">{% render 'carousel-navigation-icon', icon: navigation_icon, direction: 'previous' %}</button>
        <button class="btn btn-{{ navigation_variant }} btn--{{ navigation_variant }} btn--icon {{ navigation_modifier }} swiper-nav-button" type="button" data-multi-next aria-label="{{ 'collection_tabs.next' | t | escape }}">{% render 'carousel-navigation-icon', icon: navigation_icon, direction: 'next' %}</button>
      </div>
    {% endif %}
    <span class="visually-hidden" data-multi-status role="status" aria-live="polite"></span>
  </multiple-images-text>
  </div>
</div>
<script type="module" src="{{ 'multiple-images-with-text.js' | asset_url }}"></script>
{% render 'runtime-stylesheet', filename: 'component-runtime-sections-multiple-images-with-text.css', section_index: section.index %}

