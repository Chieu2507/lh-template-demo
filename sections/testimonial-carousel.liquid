{% liquid
  assign section_alignment = 'start'
  case section.settings.alignment
    when 'center'
      assign section_alignment = 'center'
    when 'right'
      assign section_alignment = 'end'
  endcase

  assign section_alignment_mobile = section_alignment
  if section.settings.customize_mobile_alignment
    assign section_alignment_mobile = 'start'
    case section.settings.alignment_mobile
      when 'center'
        assign section_alignment_mobile = 'center'
      when 'right'
        assign section_alignment_mobile = 'end'
    endcase
  endif

  assign padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign content_gap = section.settings.content_gap | default: 16 | plus: 0
  assign content_gap_mobile = content_gap
  if section.settings.customize_mobile_gap
    assign content_gap_mobile = section.settings.content_gap_mobile | default: content_gap | plus: 0
  endif

  assign section_width = 'page-width'
  assign container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_width = 'full-width'
    assign container_width = 'full-width'
  elsif section.settings.section_width == 'full_width_no_padding'
    assign section_width = 'full-width-no-padding'
    assign container_width = 'full-width full-width--no-padding'
  endif

  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign color_scheme = section.settings.color_scheme.id
  endif
  assign color_scheme = color_scheme | default: 'scheme-1' | handleize
%}

{% capture section_style %}
  {% if section_alignment != 'start' %}--flex-align: {{ section_alignment }};{% endif %}
  {% if section.settings.customize_mobile_alignment and section_alignment_mobile != section_alignment %}--flex-align-mobile: {{ section_alignment_mobile }};{% endif %}
  {% if section.settings.background_color != blank %}--testimonial-carousel-background-color: {{ section.settings.background_color | escape }};{% endif %}
  {% if padding_top != 0 %}--testimonial-carousel-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--testimonial-carousel-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if padding_top_mobile != padding_top %}--testimonial-carousel-padding-top-mobile: {{ padding_top_mobile }}px;{% endif %}
    {% if padding_bottom_mobile != padding_bottom %}--testimonial-carousel-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}

{% capture content_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'var(--flex-align, flex-start)',
    align_items_mobile: 'var(--flex-align-mobile, var(--flex-align, flex-start))',
    gap: content_gap,
    gap_mobile: content_gap_mobile
  %}
{% endcapture %}

<div class="testimonial-carousel testimonial-carousel--{{ section_width }}">
  <div class="section-spacing testimonial-carousel__spacing color-scheme section-color-scope {{ color_scheme }}"{% if section_style != blank %} style="{{ section_style | strip }}"{% endif %}>
    {% if section.settings.background_image != blank %}
      <div class="media-background-surface testimonial-carousel__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
      </div>
    {% endif %}

    <div class="container {{ container_width }} testimonial-carousel__container">
      <div class="testimonial-carousel__content layout-flow layout-flow--responsive align-content" style="{{ content_style | strip }}">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% render 'runtime-stylesheet', filename: 'component-runtime-sections-testimonial-carousel.css', section_index: section.index %}

{% schema %}
{
  "name": "Testimonial: Carousel",
  "class": "section-kernel",
  "enabled_on": { "templates": ["*"] },
  "blocks": [
    { "type": "carousel" },
    { "type": "header" },
    { "type": "heading" },
    { "type": "editorial-text" },
    { "type": "eyebrow" },
    { "type": "text" },
    { "type": "image" },
    { "type": "image-card" },
    { "type": "video" },
    { "type": "button" },
    { "type": "buttons" },
    { "type": "icon" },
    { "type": "divider" },
    { "type": "spacer" },
    { "type": "group" },
    { "type": "marquee" },
    { "type": "row" },
    { "type": "grid" },
    { "type": "email-signup" },
    { "type": "contact-form" },
    { "type": "product-list" },
    { "type": "countdown-timer" }
  ],
  "settings": [
    { "type": "header", "content": "t:general.layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" },
        { "value": "full_width_no_padding", "label": "t:options.section_width.full_width_no_padding" }
      ],
      "default": "page_width"
    },
    { "type": "text_alignment", "id": "alignment", "label": "t:labels.alignment", "default": "left" },
    { "type": "checkbox", "id": "customize_mobile_alignment", "label": "t:labels.customize_mobile_alignment", "default": false },
    { "type": "text_alignment", "id": "alignment_mobile", "label": "t:labels.mobile_alignment", "default": "left", "visible_if": "{{ section.settings.customize_mobile_alignment }}" },
    { "type": "range", "id": "content_gap", "label": "t:labels.content_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "customize_mobile_gap", "label": "t:labels.customize_mobile_layout", "default": false },
    { "type": "range", "id": "content_gap_mobile", "label": "t:labels.mobile_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 12, "visible_if": "{{ section.settings.customize_mobile_gap }}" },
    { "type": "header", "content": "t:general.appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "color", "alpha": true, "id": "background_color", "label": "t:labels.background" },
    { "type": "image_picker", "id": "background_image", "label": "t:labels.background_image" },
    { "type": "header", "content": "t:general.padding" },
    { "type": "range", "id": "padding_top", "label": "t:labels.top_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "t:labels.bottom_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "customize_mobile_padding", "label": "t:labels.customize_mobile_padding", "default": false },
    { "type": "range", "id": "padding_top_mobile", "label": "t:labels.mobile_top_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ section.settings.customize_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "t:labels.mobile_bottom_padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0, "visible_if": "{{ section.settings.customize_mobile_padding }}" }
  ],
  "presets": [
    {
      "name": "Testimonial: Carousel",
      "category": "Trust & social proof",
      "blocks": [
        {
          "type": "carousel",
          "settings": {
            "columns_desktop": "1",
            "columns_mobile": "1",
            "controls_style": "fraction",
            "controls_alignment": "left",
            "controls_alignment_mobile": "center",
            "loop": true,
            "show_pagination_on_desktop": false,
            "show_pagination_on_mobile": false,
            "show_navigation_on_desktop": true
          },
          "blocks": [
            {
              "type": "testimonial-item",
              "blocks": [
                { "type": "image", "settings": { "image_ratio_desktop": "square", "image_ratio_mobile": "square", "width_desktop": "fill", "width_mobile": "fill" } },
                {
                  "type": "group",
                  "settings": { "direction": "vertical", "alignment": "left", "width": "fill", "height": "fill", "gap_desktop": 16, "gap_mobile": 12, "appearance_type": "inherit", "border_type": "none", "corner_radius": "square", "shadow": "none" },
                  "blocks": [
                    { "type": "eyebrow", "settings": { "text": "<p>FROM THE PEOPLE</p>" } },
                    { "type": "icon", "settings": { "source": "library", "icon": "five-stars", "icon_width": 74, "custom_mobile": false } },
                    { "type": "text", "settings": { "text": "<p>Share a customer testimonial that builds trust in your products and brand.</p>", "text_size": "md" } },
                    { "type": "heading", "settings": { "text": "<p>— Customer name</p>", "heading_size": "xs", "html_tag": "h5", "width": "fit", "customize_mobile_size": false, "width_mobile": "fit" } }
                  ]
                }
              ]
            },
            {
              "type": "testimonial-item",
              "blocks": [
                { "type": "image", "settings": { "image_ratio_desktop": "square", "image_ratio_mobile": "square", "width_desktop": "fill", "width_mobile": "fill" } },
                {
                  "type": "group",
                  "settings": { "direction": "vertical", "alignment": "left", "width": "fill", "height": "fill", "gap_desktop": 16, "gap_mobile": 12, "appearance_type": "inherit", "border_type": "none", "corner_radius": "square", "shadow": "none" },
                  "blocks": [
                    { "type": "eyebrow", "settings": { "text": "<p>FROM THE PEOPLE</p>" } },
                    { "type": "icon", "settings": { "source": "library", "icon": "five-stars", "icon_width": 74, "custom_mobile": false } },
                    { "type": "text", "settings": { "text": "<p>Share a customer testimonial that builds trust in your products and brand.</p>", "text_size": "md" } },
                    { "type": "heading", "settings": { "text": "<p>— Customer name</p>", "heading_size": "xs", "html_tag": "h5", "width": "fit", "customize_mobile_size": false, "width_mobile": "fit" } }
                  ]
                }
              ]
            },
            {
              "type": "testimonial-item",
              "blocks": [
                { "type": "image", "settings": { "image_ratio_desktop": "square", "image_ratio_mobile": "square", "width_desktop": "fill", "width_mobile": "fill" } },
                {
                  "type": "group",
                  "settings": { "direction": "vertical", "alignment": "left", "width": "fill", "height": "fill", "gap_desktop": 16, "gap_mobile": 12, "appearance_type": "inherit", "border_type": "none", "corner_radius": "square", "shadow": "none" },
                  "blocks": [
                    { "type": "eyebrow", "settings": { "text": "<p>FROM THE PEOPLE</p>" } },
                    { "type": "icon", "settings": { "source": "library", "icon": "five-stars", "icon_width": 74, "custom_mobile": false } },
                    { "type": "text", "settings": { "text": "<p>Share a customer testimonial that builds trust in your products and brand.</p>", "text_size": "md" } },
                    { "type": "heading", "settings": { "text": "<p>— Customer name</p>", "heading_size": "xs", "html_tag": "h5", "width": "fit", "customize_mobile_size": false, "width_mobile": "fit" } }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "settings": {
        "section_width": "page_width",
        "alignment": "left",
        "customize_mobile_alignment": false,
        "alignment_mobile": "left",
        "color_scheme": "scheme-1",
