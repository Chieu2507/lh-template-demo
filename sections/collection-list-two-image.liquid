{% liquid
  assign section_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_width = 'full-width'
  endif
  assign collection_item_count = section.blocks | where: 'type', 'collection-two-image-item' | size
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
%}
<script type="module" src="{{ 'collection-list-two-image.js' | asset_url }}"></script>
<div class="section-spacing collection-list-two-image color-scheme section-color-scope {{ scheme }}" data-collection-list-two-image data-image-size="{{ section.settings.image_size | default: 'medium' }}" style="--collection-list-two-image-item-count:{{ collection_item_count | at_least: 1 }};--collection-list-two-image-gap:{{ section.settings.gap_desktop }}px;--collection-list-two-image-gap-mobile:{{ section.settings.gap_mobile }}px;--collection-list-two-image-header-gap:{{ section.settings.header_gap_desktop }}px;--collection-list-two-image-header-gap-mobile:{{ section.settings.header_gap_mobile }}px;--collection-list-two-image-padding-top:{{ section.settings.padding_top }}px;--collection-list-two-image-padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.customize_mobile_padding %}--collection-list-two-image-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;--collection-list-two-image-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;{% endif %}{% if section.settings.background_color != blank %}--collection-list-two-image-background:{{ section.settings.background_color }};{% endif %}">
  <div class="container {{ section_width }}">
    <div class="collection-list-two-image__content">
      <div class="collection-list-two-image__header align-content">
        {% content_for 'block', type: 'header', id: 'look-header' %}
      </div>
      {% capture collection_items %}{% content_for 'blocks' %}{% endcapture %}
      {% render 'swiper-carousel', content: collection_items, root_class: 'collection-two-image', wrapper_class: 'collection-two-image__items', aria_label: 'Collections' %}
    </div>
  </div>
</div>
{% if section.settings.background_color != blank %}
  {% style %}#shopify-section-{{ section.id }} { background-color:{{ section.settings.background_color }}; }{% endstyle %}
{% endif %}
{% render 'runtime-stylesheet', filename: 'component-runtime-sections-collection-list-two-image.css', section_index: section.index %}
{% schema %}
{
  "name": "Collection list: 2 images",
  "class": "section-collection-list-two-image",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "collection-two-image-item"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page_width",
          "label": "Page"
        },
        {
          "value": "full_width",
          "label": "Full"
        }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        {
          "value": "display",
          "label": "t:options.heading_size.display"
        },
        {
          "value": "xl",
          "label": "t:options.heading_size.xl"
        },
        {
          "value": "lg",
          "label": "t:options.heading_size.lg"
        },
        {
          "value": "md",
          "label": "t:options.heading_size.md"
        },
        {
          "value": "sm",
          "label": "t:options.heading_size.sm"
        },
        {
          "value": "xs",
          "label": "t:options.heading_size.xs"
        },
        {
          "value": "custom",
          "label": "t:options.heading_size.custom"
        }
      ],
      "default": "display"
    },
    {
      "type": "range",
      "id": "custom_heading_size",
      "label": "Custom size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.title_size == 'custom' }}"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "t:labels.html_tag",
      "options": [
        {
          "value": "div",
          "label": "t:options.html_tag.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.html_tag.h1"
        },
        {
          "value": "h2",
          "label": "t:options.html_tag.h2"
        },
        {
          "value": "h3",
          "label": "t:options.html_tag.h3"
        },
        {
          "value": "h4",
          "label": "t:options.html_tag.h4"
        },
        {
          "value": "h5",
          "label": "t:options.html_tag.h5"
        },
        {
          "value": "h6",
          "label": "t:options.html_tag.h6"
        }
      ],
      "default": "h2",
      "info": "t:info.heading_html_tag"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Desktop image size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop image spacing",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile card spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "header_gap_desktop",
      "label": "Header spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "header_gap_mobile",
      "label": "Mobile header spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "alpha": true
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 144
    },
    {"type": "checkbox", "id": "customize_mobile_padding", "label": "t:labels.customize_mobile_padding", "default": false},
    {"type": "range", "id": "padding_top_mobile", "label": "t:labels.mobile_top_padding", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 20, "visible_if": "{{ section.settings.customize_mobile_padding }}"},
    {"type": "range", "id": "padding_bottom_mobile", "label": "t:labels.mobile_bottom_padding", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 112, "visible_if": "{{ section.settings.customize_mobile_padding }}"}
  ],
  "presets": [
    {
      "name": "Collection list: 2 images",
      "category": "Collections",
      "blocks": [
        {
          "type": "header",
          "id": "look-header",
          "static": true,
          "settings": {
            "inherit_alignment": true
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {
                "text": "<p>Collections</p>",
                "show_background": false
              }
            }
          ]
        },
        {
          "type": "collection-two-image-item"
        },
        {
          "type": "collection-two-image-item"
        },
        {
          "type": "collection-two-image-item"
        },
        {
          "type": "collection-two-image-item"
        },
        {
          "type": "collection-two-image-item"
        }
      ]
    }
  ]
}
{% endschema %}
