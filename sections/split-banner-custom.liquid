{% liquid
  assign split_section_width = section.settings.section_width | default: 'full_width'
  unless split_section_width == 'page_width' or split_section_width == 'full_width' or split_section_width == 'full_width_no_padding'
    assign split_section_width = 'full_width'
  endunless

  assign split_section_boxed_layout = false
  if section.settings.enable_boxed_layout == true or section.settings.enable_boxed_layout == 'true'
    assign split_section_boxed_layout = true
  endif

  assign split_section_container_width = 'page-width'
  if split_section_width == 'full_width' or split_section_width == 'full_width_no_padding'
    assign split_section_container_width = 'full-width'
  endif
  if split_section_width == 'full_width_no_padding'
    assign split_section_container_width = 'full-width split-banner__container--no-padding'
  endif

  assign split_section_direction = section.settings.direction | default: 'horizontal'
  unless split_section_direction == 'horizontal' or split_section_direction == 'vertical'
    assign split_section_direction = 'horizontal'
  endunless

  assign split_section_position = section.settings.position | default: 'center'
  unless split_section_position == 'top' or split_section_position == 'center' or split_section_position == 'bottom'
    assign split_section_position = 'center'
  endunless

  assign split_section_horizontal_alignment = section.settings.horizontal_alignment | default: 'space-between'
  unless split_section_horizontal_alignment == 'left' or split_section_horizontal_alignment == 'center' or split_section_horizontal_alignment == 'right' or split_section_horizontal_alignment == 'space-between'
    assign split_section_horizontal_alignment = 'space-between'
  endunless

  assign split_section_alignment = section.settings.alignment | default: 'left'
  unless split_section_alignment == 'left' or split_section_alignment == 'center' or split_section_alignment == 'right'
    assign split_section_alignment = 'left'
  endunless

  assign split_section_alignment_mobile = section.settings.alignment_mobile | default: 'left'
  unless split_section_alignment_mobile == 'left' or split_section_alignment_mobile == 'center' or split_section_alignment_mobile == 'right'
    assign split_section_alignment_mobile = 'left'
  endunless

  assign split_section_flow_position = 'top'
  if split_section_direction == 'horizontal'
    assign split_section_flow_position = split_section_position
  endif

  assign split_section_flow_wrap = 'nowrap'

  assign split_section_flow_alignment = 'start'
  case split_section_alignment
    when 'center'
      assign split_section_flow_alignment = 'center'
    when 'right'
      assign split_section_flow_alignment = 'end'
  endcase

  assign split_section_flow_horizontal_alignment = 'flex-start'
  case split_section_horizontal_alignment
    when 'left'
      assign split_section_flow_horizontal_alignment = 'flex-start'
    when 'center'
      assign split_section_flow_horizontal_alignment = 'center'
    when 'right'
      assign split_section_flow_horizontal_alignment = 'flex-end'
    when 'space-between'
      assign split_section_flow_horizontal_alignment = 'space-between'
  endcase

  assign split_section_flow_mobile_alignment = 'start'
  case split_section_alignment_mobile
    when 'center'
      assign split_section_flow_mobile_alignment = 'center'
    when 'right'
      assign split_section_flow_mobile_alignment = 'end'
  endcase

  assign split_section_flow_mobile_justify = 'flex-start'
  case split_section_alignment_mobile
    when 'center'
      assign split_section_flow_mobile_justify = 'center'
    when 'right'
      assign split_section_flow_mobile_justify = 'flex-end'
  endcase

  assign split_section_mobile_vertical = false
  if split_section_direction == 'horizontal' and section.settings.customize_mobile_alignment
    assign split_section_mobile_vertical = true
  endif

  assign split_section_gap_desktop = section.settings.gap_desktop | default: 36 | plus: 0
  if split_section_gap_desktop < 0 or split_section_gap_desktop > 100
    assign split_section_gap_desktop = 36
  endif
  assign split_section_gap_mobile = section.settings.gap_mobile | default: 36 | plus: 0
  if split_section_gap_mobile < 0 or split_section_gap_mobile > 100
    assign split_section_gap_mobile = 36
  endif

  assign split_section_content_class = 'split-banner__content layout-flow layout-flow--responsive split-banner__content--direction-' | append: split_section_direction
  if split_section_direction == 'horizontal'
    assign split_section_content_class = split_section_content_class | append: ' split-banner__content--position-' | append: split_section_position
    assign split_section_content_class = split_section_content_class | append: ' split-banner__content--horizontal-align-' | append: split_section_horizontal_alignment
  else
    assign split_section_content_class = split_section_content_class | append: ' split-banner__content--align-' | append: split_section_alignment
  endif

  if split_section_mobile_vertical
    assign split_section_content_class = split_section_content_class | append: ' split-banner__content--mobile-vertical split-banner__content--mobile-align-' | append: split_section_alignment_mobile
  endif

  assign split_section_scheme = section.settings.color_scheme | default: 'scheme-3'
  if section.settings.color_scheme.id != blank
    assign split_section_scheme = section.settings.color_scheme.id
  endif
  assign split_section_scheme = split_section_scheme | default: 'scheme-3' | handleize

  assign split_section_boxed_scheme = section.settings.boxed_color_scheme | default: 'scheme-1'
  if section.settings.boxed_color_scheme.id != blank
    assign split_section_boxed_scheme = section.settings.boxed_color_scheme.id
  endif
  assign split_section_boxed_scheme = split_section_boxed_scheme | default: 'scheme-1' | handleize

  assign split_section_padding_top = section.settings.padding_top | default: 16 | plus: 0
  assign split_section_padding_bottom = section.settings.padding_bottom | default: 16 | plus: 0
  assign split_section_padding_top_mobile = section.settings.padding_top_mobile | default: split_section_padding_top | plus: 0
  assign split_section_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: split_section_padding_bottom | plus: 0

  assign split_boxed_padding_block = section.settings.boxed_padding_block | default: 70 | plus: 0
  if split_boxed_padding_block < 0 or split_boxed_padding_block > 100
    assign split_boxed_padding_block = 70
  endif
  assign split_boxed_padding_inline = section.settings.boxed_padding_inline | default: 50 | plus: 0
  if split_boxed_padding_inline < 0 or split_boxed_padding_inline > 100
    assign split_boxed_padding_inline = 50
  endif
  assign split_boxed_padding_block_mobile = section.settings.boxed_padding_block_mobile | default: 40 | plus: 0
  if split_boxed_padding_block_mobile < 0 or split_boxed_padding_block_mobile > 100
    assign split_boxed_padding_block_mobile = 40
  endif
  assign split_boxed_padding_inline_mobile = section.settings.boxed_padding_inline_mobile | default: 30 | plus: 0
  if split_boxed_padding_inline_mobile < 0 or split_boxed_padding_inline_mobile > 100
    assign split_boxed_padding_inline_mobile = 30
  endif
%}

{% capture split_section_style %}
  --split-banner-padding-top: {{ split_section_padding_top }}{% if section.settings.padding_unit == 'percent' %}%{% else %}px{% endif %};
  --split-height: {% case section.settings.height %}{% when 'full_screen' %}100svh{% when 'custom' %}{{ section.settings.custom_height | default: 100 }}svh{% else %}auto{% endcase %};
  {% if section.settings.background_color != blank %}--split-background: {{ section.settings.background_color }};{% endif %}
  {% if section.settings.overlay_color != blank %}--split-overlay: {{ section.settings.overlay_color }};{% endif %}
  --split-banner-padding-bottom: {{ split_section_padding_bottom }}{% if section.settings.padding_unit == 'percent' %}%{% else %}px{% endif %};
  {% if section.settings.customize_mobile_padding %}
    --split-banner-padding-top-mobile: {{ split_section_padding_top_mobile }}px;
    --split-banner-padding-bottom-mobile: {{ split_section_padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}
{% assign split_section_style = split_section_style | strip %}

{% capture split_section_content_style %}
  --split-child-count: {{ section.blocks.size | at_least: 1 }};
  --split-distribution-gap: {{ split_section_gap_desktop }}px;
  {% render 'layout-flow-group-style',
    direction: split_section_direction,
    wrap: split_section_flow_wrap,
    position: split_section_flow_position,
    alignment: split_section_flow_alignment,
    horizontal_alignment: split_section_flow_horizontal_alignment,
    mobile_vertical: split_section_mobile_vertical,
    mobile_alignment: split_section_flow_mobile_alignment,
    mobile_justify: split_section_flow_mobile_justify,
    gap: split_section_gap_desktop,
    gap_mobile: split_section_gap_mobile
  %}
{% endcapture %}
{% assign split_section_content_style = split_section_content_style | strip %}

{% capture split_section_boxed_style %}
  {% if split_section_boxed_layout %}
    --split-border-width: {{ section.settings.boxed_border_thickness | default: 0 }}px;
    --split-box-shadow: {% case section.settings.boxed_shadow %}{% when 'small' %}0 2px 6px var(--shadow-color, #0002){% when 'medium' %}0 6px 16px var(--shadow-color, #0002){% when 'large' %}0 12px 32px var(--shadow-color, #0002){% else %}none{% endcase %};
    --split-boxed-padding-block: {{ split_boxed_padding_block }}px;
    --split-boxed-padding-inline: {{ split_boxed_padding_inline }}px;
    --split-boxed-padding-block-mobile: {{ split_boxed_padding_block_mobile }}px;
    --split-boxed-padding-inline-mobile: {{ split_boxed_padding_inline_mobile }}px;
  {% endif %}
{% endcapture %}
{% assign split_section_boxed_style = split_section_boxed_style | strip %}

<div
  class="section-spacing split-banner{% if section.settings.show_top_divider %} split-banner--top-divider{% endif %}{% if section.settings.show_bottom_divider %} split-banner--bottom-divider{% endif %}{% if section.settings.enable_sticky %} split-banner--sticky{% endif %} color-scheme section-color-scope {{ split_section_scheme }}"
  {% if split_section_style != blank %}style="{{ split_section_style }}"{% endif %}
>
  {% if section.settings.background_media != 'none' and section.settings.background_media != blank %}
    {% render 'media-background', media_type: section.settings.background_media, image: section.settings.background_image, mobile_image: section.settings.mobile_background_image, video: section.settings.background_video, mobile_video: section.settings.mobile_background_video, aria_hidden: true, sizes: '100vw' %}
    {% if section.settings.overlay_color != blank %}<div class="split-banner__overlay" aria-hidden="true"></div>{% endif %}
  {% endif %}
  <div class="container {{ split_section_container_width }} split-banner__container">
    <div
      class="split-banner__box{% if split_section_boxed_layout %} split-banner__box--boxed color-scheme section-color-scope {{ split_section_boxed_scheme }}{% endif %}"
      {% if split_section_boxed_style != blank %}style="{{ split_section_boxed_style }}"{% endif %}
    >
      <div
        class="{{ split_section_content_class }}"
        {% if split_section_content_style != blank %}style="{{ split_section_content_style }}"{% endif %}
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .split-banner {
    position: relative;
    background-color: var(--split-background, var(--background-color));
    width: 100%;
    padding-top: var(--split-banner-padding-top, 16px);
    padding-bottom: var(--split-banner-padding-bottom, 16px);
  }

  .split-banner__container {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .split-banner__box {
    width: 100%;
    min-width: 0;
  }

  .split-banner__box--boxed {
    border: var(--split-border-width, 0px) solid var(--border-color);
    border-radius: var(--media-radius, var(--radius-rounded));
    box-shadow: var(--split-box-shadow, none);
    padding-block: var(--split-boxed-padding-block, 70px);
    padding-inline: var(--split-boxed-padding-inline, 50px);
  }

  .split-banner__content {
    min-height: var(--split-height, auto);
    min-width: 0;
  }

  .split-banner__content > .group,
  .split-banner__content > countdown-timer,
  .split-banner__content > .button-block {
    min-width: 0;
  }

  @media (max-width: 767.98px) {
    .split-banner {
      padding-top: var(--split-banner-padding-top-mobile, calc(var(--split-banner-padding-top, 16px) * .5));
      padding-bottom: var(--split-banner-padding-bottom-mobile, calc(var(--split-banner-padding-bottom, 16px) * .5));
    }

    .split-banner__box--boxed {
    border: var(--split-border-width, 0px) solid var(--border-color);
    border-radius: var(--media-radius, var(--radius-rounded));
    box-shadow: var(--split-box-shadow, none);
      padding-block: var(--split-boxed-padding-block-mobile, 40px);
      padding-inline: var(--split-boxed-padding-inline-mobile, 30px);
    }

  }

  .split-banner__container--no-padding { padding-inline: 0; }
  .split-banner__overlay { position: absolute; inset: 0; background: var(--split-overlay); pointer-events: none; }
  .split-banner--top-divider { border-top: 1px solid var(--border-color); }
  .split-banner--bottom-divider { border-bottom: 1px solid var(--border-color); }
  .split-banner__content--direction-horizontal > :is(.group--width-fill, .image-block--width-fill) { flex: 1 1 calc((100% - (var(--split-distribution-gap, 0px) * (var(--split-child-count, 1) - 1))) / var(--split-child-count, 1)); }
  .split-banner__content--direction-horizontal > .group--height-fill { align-self: stretch; height: auto; }
  .split-banner--sticky .split-banner__content > .group { position: sticky; top: calc(var(--header-height, 0px) + 2rem); align-self: flex-start; }
  @media (min-width: 768px) and (max-width: 1149.98px) {
    .split-banner { padding-block: calc(var(--split-banner-padding-top, 16px) * .75) calc(var(--split-banner-padding-bottom, 16px) * .75); }
  }
  @media (max-width: 767.98px) {
    .split-banner__content--mobile-vertical > :is(.group, .image-block) { flex: 0 1 auto; }
    .split-banner--sticky .split-banner__content > .group { position: static; }
  }
{% endstylesheet %}

