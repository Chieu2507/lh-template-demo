{% liquid
  assign collections_background_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign collections_background_scheme = section.settings.color_scheme.id
  endif
  assign collections_background_scheme = collections_background_scheme | handleize
  assign collections_background_collection_scheme = section.settings.collection_color_scheme | default: 'scheme-1'
  if section.settings.collection_color_scheme.id != blank
    assign collections_background_collection_scheme = section.settings.collection_color_scheme.id
  endif
  assign collections_background_collection_scheme = collections_background_collection_scheme | handleize
  assign collections_background_first_block = section.blocks.first
  assign collections_background_first_collection = collections_background_first_block.settings.collection
  assign collections_background_first_image = collections_background_first_block.settings.image | default: collections_background_first_collection.image
  assign collections_background_first_mobile_image = collections_background_first_block.settings.mobile_image | default: collections_background_first_image
  assign collections_background_aspect_ratio = collections_background_first_image.aspect_ratio | default: 1.5
  assign collections_background_mobile_aspect_ratio = collections_background_first_mobile_image.aspect_ratio | default: collections_background_aspect_ratio
  assign collections_background_heading_size = section.settings.heading_size | default: 'display'
  assign collections_background_heading_size_mobile = section.settings.heading_size_mobile | default: 'lg'
  assign collections_background_heading_custom_size = section.settings.custom_heading_size | default: 24 | plus: 0
  assign collections_background_heading_custom_size_mobile = section.settings.custom_heading_size_mobile | default: 24 | plus: 0
  if collections_background_heading_custom_size < 10 or collections_background_heading_custom_size > 100
    assign collections_background_heading_custom_size = 24
  endif
  if collections_background_heading_custom_size_mobile < 10 or collections_background_heading_custom_size_mobile > 100
    assign collections_background_heading_custom_size_mobile = 24
  endif
%}

{% capture collections_background_style %}
  --collections-background-title-width: {{ section.settings.title_max_width }}px;
  --collections-background-gap: {{ section.settings.gap }}px;
  --collections-background-gap-mobile: {{ section.settings.gap_mobile }}px;
  --collections-background-text-opacity: {{ section.settings.text_opacity | times: 0.01 }};
  --collections-background-heading-size: {% if collections_background_heading_size == 'custom' %}{{ collections_background_heading_custom_size }}px{% else %}var(--font-heading-{{ collections_background_heading_size }}){% endif %};
  --collections-background-heading-line-height: var(--font-heading-{{ collections_background_heading_size }}-line-height);
  --collections-background-heading-spacing: var(--font-heading-{{ collections_background_heading_size }}-letter-spacing);
  --collections-background-heading-transform: var(--font-heading-{{ collections_background_heading_size }}-text-transform);
  --collections-background-heading-size-mobile: {% if collections_background_heading_size_mobile == 'custom' %}{{ collections_background_heading_custom_size_mobile }}px{% else %}var(--font-heading-{{ collections_background_heading_size_mobile }}){% endif %};
  --collections-background-heading-line-height-mobile: var(--font-heading-{{ collections_background_heading_size_mobile }}-line-height);
  --collections-background-heading-spacing-mobile: var(--font-heading-{{ collections_background_heading_size_mobile }}-letter-spacing);
  --collections-background-heading-transform-mobile: var(--font-heading-{{ collections_background_heading_size_mobile }}-text-transform);
  --collections-background-aspect-ratio: {{ collections_background_aspect_ratio }};
  --collections-background-mobile-aspect-ratio: {{ collections_background_mobile_aspect_ratio }};
  --collections-background-padding-top: {{ section.settings.padding_top }}px;
  --collections-background-padding-bottom: {{ section.settings.padding_bottom }}px;
  {% if section.settings.customize_mobile_padding %}--collections-background-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;--collections-background-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;{% endif %}
{% endcapture %}

<div class="section-spacing collections-with-background color-scheme section-color-scope {{ collections_background_scheme }}" style="{{ collections_background_style | strip }}" data-collections-background data-title-layout="{{ section.settings.title_layout }}" data-desktop-position="{{ section.settings.desktop_position }}" data-mobile-layout="{{ section.settings.mobile_layout }}" data-mobile-position="{{ section.settings.mobile_position }}" data-sticky-title="{{ section.settings.sticky_title }}" data-outline-text="{{ section.settings.outline_text }}">
  {% if section.settings.background_media != 'none' %}
    <div class="media-background-surface collections-with-background__background" aria-hidden="true">
      {% if section.settings.background_media == 'image' and section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
      {% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}
        {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x' }}
      {% else %}
        <div class="collections-with-background__background-placeholder placeholder-image">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  {% endif %}
  <div class="collections-with-background__frame collections-with-background__frame--{{ section.settings.section_width }} collections-with-background__frame--{{ section.settings.height }} collections-with-background__frame--mobile-{{ section.settings.mobile_width }} collections-with-background__frame--mobile-height-{{ section.settings.mobile_height }}">
    <div class="swiper collections-with-background__mobile-swiper" data-collections-background-swiper>
      <div class="swiper-wrapper collections-with-background__panels" data-collections-background-panels>{% content_for 'blocks' %}</div>
    </div>
    <div class="collections-with-background__titles {{ collections_background_collection_scheme }}" role="tablist" aria-label="Collections" data-collections-background-tabs></div>
  </div>
</div>

<script type="module" src="{{ 'collections-with-background.js' | asset_url }}"></script>

{% render 'runtime-stylesheet', filename: 'component-runtime-sections-collections-with-background.css', section_index: section.index %}

